<Window x:Class="MyHelperWPFTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MyHelperWPFTest"
        mc:Ignorable="d"
        Title="MainWindow" Height="350" Width="400"
    xmlns:theme="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero2">
    <Window.Resources>
        <Style TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Margin="{TemplateBinding Margin}"
                        Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <DockPanel>
                                <Border Margin="2,2,4,2" BorderBrush="#ff6800" BorderThickness="2" CornerRadius="100" 
                                DockPanel.Dock="Left" 
                                Background="#fff4bd"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                    <Ellipse x:Name="mark" MinHeight="6" MinWidth="6" 
                                     Fill="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=BorderBrush}" 
                                     Margin="2" Opacity="0"/>
                                </Border>
                                <ContentPresenter Content="{TemplateBinding Content}"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Opacity"
                                TargetName="mark"
                                Value="0.2"/>
                            </MultiTrigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Opacity"
                                TargetName="mark"
                                Value="1"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter Property="Opacity"
                                TargetName="mark"
                                Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Background="#FFD700">
        <StackPanel Orientation="Vertical">
            <RadioButton Content="Контенот"
                         IsChecked="{x:Null}"/>
            <RadioButton Content="Контенот" Margin="0,1"/>
        </StackPanel>
    </Grid>
</Window>
