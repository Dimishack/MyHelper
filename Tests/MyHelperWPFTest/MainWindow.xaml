<Window x:Class="MyHelperWPFTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MyHelperWPFTest"
        mc:Ignorable="d"
        Title="MainWindow" Height="350" Width="400">
    <Window.Resources>
        <ImageBrush x:Key="UpArrow" ImageSource="Up_Arrow_Default.png"/>
        <ImageBrush x:Key="DownArrow" ImageSource="Down_Arrow_Default.png"/>
        <ImageBrush x:Key="Thumbbb" ImageSource="Thumb_Icon_Default.png"/>


        <Style x:Key="ScrollBar_Track" TargetType="{x:Type RepeatButton}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollBar_UpArrow" TargetType="RepeatButton">
            
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border x:Name="border" CornerRadius="10" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="0"
                                SnapsToDevicePixels="True">
                            <Path Data="M12.5,4
                          C10.5,4 -2,14 2,16
                          L23,16
                          C27,14 14.5,4 12.5,4 " Stroke="Black" StrokeThickness="1"
                          Fill="Aquamarine"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="25"/>
                    <Setter Property="Height" Value="Auto"/>
                    <Setter Property="Margin" Value="2"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="23"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="23"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="1" CornerRadius="5"
                                            Background="#ffb961"
                                            Width="21"/>
                                    <RepeatButton x:Name="rb_Up" Grid.Row="0"
                                                  Focusable="False"
                                                  Command="ScrollBar.LineUpCommand"
                                                  Style="{StaticResource ScrollBar_UpArrow}"/>
                                    <RepeatButton x:Name="rb_Down" Grid.Row="2"
                                                  Focusable="False"
                                                  Command="ScrollBar.LineDownCommand"
                                                  Style="{StaticResource ScrollBar_UpArrow}"/>
                                    <Track x:Name="PART_Track"
                                           Grid.Row="1"
                                           IsDirectionReversed="True">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Margin="3,2,3,2"
                                                          Command="ScrollBar.PageUpCommand"
                                                          Style="{StaticResource ScrollBar_Track}"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Style>
                                                    <Style TargetType="Thumb">
                                                        <Setter Property="SnapsToDevicePixels" Value="True"/>
                                                        <Setter Property="OverridesDefaultStyle" Value="True"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Thumb">
                                                                    <Border Width="{TemplateBinding Width}" CornerRadius="5"
                                                                            Background="Aqua" Margin="4,2"/>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Thumb.Style>
                                            </Thumb>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Margin="3,2,3,2"
                                                          Command="ScrollBar.PageDownCommand"
                                                          Style="{StaticResource ScrollBar_Track}"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <DockPanel Background="#FFD700">
        <ListBox HorizontalAlignment="Left" VerticalAlignment="Top">
            <ListBoxItem Content="ListBoxItem1"/>
            <ListBoxItem Content="ListBoxItem2"/>
            <ListBoxItem Content="ListBoxItem3"/>
            <ListBoxItem Content="ListBoxItem4"/>
            <ListBoxItem Content="ListBoxItem5"/>
            <ListBoxItem Content="ListBoxItem6"/>
        </ListBox>
        <ListBox HorizontalAlignment="Left" VerticalAlignment="Top"
                 Height="128">
            <ListBoxItem Content="ListBoxItem1"/>
            <ListBoxItem Content="ListBoxItem2"/>
            <ListBoxItem Content="ListBoxItem3"/>
            <ListBoxItem Content="ListBoxItem4"/>
            <ListBoxItem Content="ListBoxItem5"/>
            <ListBoxItem Content="ListBoxItem6"/>
            <ListBoxItem Content="gg"/>
            <ListBoxItem Content="dds"/>
            <ListBoxItem Content="agae"/>
            <ListBoxItem Content="eggeregerg"/>
            <ListBoxItem Content="regregerg"/>
            <ListBoxItem Content="ListBoxIgregvtem6"/>
            <ListBoxItem Content="ListBoxItem1"/>
            <ListBoxItem Content="ListBoxItem2"/>
            <ListBoxItem Content="ListBoxItem3"/>
            <ListBoxItem Content="ListBoxItem4"/>
            <ListBoxItem Content="ListBoxItem5"/>
            <ListBoxItem Content="ListBoxItem6"/>
            <ListBox.Style>
                <Style TargetType="ListBox">
                    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBox">
                                <Border Background="#ffec8b" BorderThickness="0"
                                        BorderBrush="Transparent">
                                    <ScrollViewer Focusable="False" Padding="2">
                                        <ItemsPresenter SnapsToDevicePixels="True"/>
                                    </ScrollViewer>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsGrouping" Value="true"/>
                                            <Condition Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="false"/>
                                        </MultiTrigger.Conditions>
                                        <Setter Property="ScrollViewer.CanContentScroll" Value="false"/>
                                    </MultiTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.Style>
        </ListBox>
    </DockPanel>
</Window>
