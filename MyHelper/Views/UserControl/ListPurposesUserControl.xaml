<UserControl x:Class="MyHelper.Views.UserControls.ListPurposesUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MyHelper.Views.UserControls"
             
             xmlns:vm="clr-namespace:MyHelper.ViewModels"
             xmlns:purpose="clr-namespace:MyHelper.Models.Purposes"
             
             d:DataContext="{d:DesignInstance vm:ListPurposesViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="450" d:DesignWidth="800"
             MinHeight="250">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <GroupBox Grid.Column="0" Header="Группа целей">
            <ListBox ItemsSource="{Binding ListMyPurposes}" SelectedItem="{Binding SelectedListMyPurposes}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="purpose:MyPurposes">
                        <TextBlock Text="{Binding Year}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>
        <GroupBox Grid.Column="1" Header="{Binding SelectedListMyPurposes.Name, FallbackValue='Выберите год'}">
            <DockPanel>
                <Grid DockPanel.Dock="Bottom" Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="3,0">
                        <StackPanel.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="14"/>
                            </Style>
                        </StackPanel.Resources>
                        <TextBlock Text="{Binding MyPurposesCount, StringFormat='Всего/Выполненных: {0}/'}"/>
                        <TextBlock Text="{Binding CompletingMyPurposesCount}"/>
                    </StackPanel>
                    <ProgressBar Grid.Column="1" Maximum="1" Value="{Binding Percent, Mode=OneWay}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Percent, StringFormat=p1}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Grid>
                <DataGrid ItemsSource="{Binding SelectedListMyPurposes.ListPurposes}" SelectedItem="{Binding SelectedMyPurpose}">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Выполнено" Binding="{Binding IsCompleted}"/>
                        <DataGridTextColumn Header="Цель" Binding="{Binding Purpose}" 
                                        ElementStyle="{StaticResource TextWrap}"
                                        Width="Auto" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Подцели" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Показать"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Примечание" Binding="{Binding Note}"
                                        ElementStyle="{StaticResource TextWrap}"
                                        Width="*" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </GroupBox>
        <GroupBox Grid.Column="2" Header="Панель управления">
            <UniformGrid Columns="1">
                <UniformGrid.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Margin" Value="3,5"/>
                    </Style>
                </UniformGrid.Resources>
                <Button Content="Добавить год"/>
                <Button Content="Редактировать год"/>
                <Separator/>
                <Button Content="Добавить" Command="{Binding CreateNewPurposeCommand}"/>
                <Button Content="Удалить" Command="{Binding DeletePurposeCommand}"/>
                <Button Content="Редактировать" Command="{Binding EditMyPurposeCommand}"/>
                <Button Content="Сохранить" Command="{Binding SaveListMyPurposesCommand}" CommandParameter="{Binding ListMyPurposes}"/>
            </UniformGrid>
        </GroupBox>
    </Grid>
</UserControl>
