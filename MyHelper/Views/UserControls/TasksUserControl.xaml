<UserControl x:Class="MyHelper.Views.UserControls.TasksUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MyHelper.Views.UserControls"
             
             xmlns:vm="clr-namespace:MyHelper.ViewModels"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:cusB="clr-namespace:MyHelper.Infrastructure.Behaviors"
             
             d:DataContext="{d:DesignInstance {x:Type vm:TasksUCViewModel},IsDesignTimeCreatable=True}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource ShowMainUserControlAnimation}"/>
        </EventTrigger>
    </UserControl.Triggers>
    <UserControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockMainStyle}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource ComboBoxMainStyle}"/>
    </UserControl.Resources>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <DockPanel>
        <ListBox Style="{StaticResource ListBoxMainStyle}"
                 ItemsSource="{Binding TasksView}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource BorderInListBoxStyle}">
                        <StackPanel Style="{StaticResource StackPanelVerticalOrientationStyle}">
                            <StackPanel.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockInListBoxStyle}"/>
                            </StackPanel.Resources>
                            <TextBlock Text="{Binding Name, StringFormat='Задача: {0}'}"
                               FontWeight="{StaticResource FontWeightBold}"/>
                            <TextBlock Text="{Binding Note, StringFormat='Note: {0}'}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
