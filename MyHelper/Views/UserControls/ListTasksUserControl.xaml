<UserControl x:Class="MyHelper.Views.UserControls.ListTasksUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"  mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MyHelper.Views.UserControls"
             
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:vm="clr-namespace:MyHelper.ViewModels"
             
             d:DataContext="{d:DesignInstance {x:Type vm:ListTasksUCViewModel}}"
             d:DesignHeight="450" d:DesignWidth="800">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <DockPanel>
        <GroupBox DockPanel.Dock="Left" Header="Группы">
            <ListBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Key}"/>
                            <TextBlock Text="{Binding Value, StringFormat=' ({0})'}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>
        <DockPanel DockPanel.Dock="Right" Width="120">
            <GroupBox DockPanel.Dock="Top" Header="Сортировка">
                <ComboBox ItemsSource="{Binding Sorting.Keys}" SelectedItem="{Binding SelectedSorting}"/>
            </GroupBox>
            <UniformGrid Columns="1">
                <UniformGrid.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource ForPanels}"/>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource ForPanelsInButton}"/>
                </UniformGrid.Resources>
                <Button Command="{Binding AddNewTaskCommand}">
                    <TextBlock>Добавить <LineBreak/> задачу </TextBlock>
                </Button>
                <Button Command="{Binding EditTaskCommand}"
                        CommandParameter="{Binding SelectedTask}">
                    <TextBlock>Редактировать <LineBreak/> задачу</TextBlock>
                </Button>
                <Separator/>
                <Button Command="{Binding SaveTasksCommand}">
                    <TextBlock>Сохранить <LineBreak/> список задач</TextBlock>
                </Button>
            </UniformGrid>
        </DockPanel>
        <GroupBox Header="Задачи">
            <ListBox ItemsSource="{Binding ListTasksView}" SelectedItem="{Binding SelectedTask}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderThickness="2" Background="WhiteSmoke" BorderBrush="SandyBrown"
                                    Padding="5">
                            <Grid>
                                <StackPanel Orientation="Vertical" Margin="5,3,15,3">
                                    <TextBlock Text="{Binding Task, StringFormat='Задача: {0}'}"
                                       FontWeight="Bold"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Важность/Срочность: "/>
                                        <CheckBox IsChecked="{Binding Prompt}"/>
                                        <TextBlock Text="/"/>
                                        <CheckBox IsChecked="{Binding Important}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Group, StringFormat='Группа: {0}'}"/>
                                    <TextBlock Text="{Binding Term, StringFormat='Срок: {0:d}'}"/>
                                    <TextBlock Text="{Binding Note, StringFormat='Примечание: {0}'}"/>
                                </StackPanel>
                                <Button Style="{StaticResource ForDeleteInListBoxes}"
                                        Command="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, 
                                                  Path=DataContext.DeleteTaskCommand}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>
    </DockPanel>
</UserControl>
