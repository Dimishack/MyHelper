<UserControl x:Class="MyHelper.Views.UserControls.FilmsUC.Add_EditFilmUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MyHelper.Views.UserControls.FilmsUC"
             
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:cusB="clr-namespace:MyHelper.Infrastructure.Behaviors"
             xmlns:vm="clr-namespace:MyHelper.ViewModels"
             
             d:DataContext="{d:DesignInstance Type={x:Type vm:FilmsUCViewModel}, IsDesignTimeCreatable=True}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Height="0" VerticalAlignment="Bottom">
        <i:Interaction.Behaviors>
            <cusB:ShowAdditionalUserControl MaxHeight="310" ManagementShow="{Binding ShowAdd_EditUserControl}"/>
        </i:Interaction.Behaviors>
        <Border Style="{StaticResource BorderStyle_AdditionalUserControl}"/>
        <Grid Margin="5">
            <Grid.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockStyle_AdditionalUserControl}"/>
                <Style TargetType="TextBox" BasedOn="{StaticResource TextBoxStyle_AdditionalUserControl}"/>
                <Style TargetType="ComboBox" BasedOn="{StaticResource ComboBoxForAdd_Edit}"/>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Режиссер: "/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Название фильма: "/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Дата выхода: "/>
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Формат: "/>
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Жанры: "/>

            <TextBox Grid.Row="0" Grid.Column="1"
                     Text="{Binding FilmForEdit.Producer, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBox x:Name="tb_Name" Grid.Row="1" Grid.Column="1"
                     Text="{Binding FilmForEdit.Name, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBox Grid.Row="2" Grid.Column="1"
                     Text="{Binding FilmForEdit.ReleaseYear, UpdateSourceTrigger=PropertyChanged}"/>
            <DockPanel Grid.Row="3" Grid.Column="1">
                <Grid DockPanel.Dock="Right"
                      Visibility="{Binding EditElement, Converter={StaticResource bool2VisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" 
                           Text="Статус: "
                           VerticalAlignment="Center"
                           FontWeight="{StaticResource FontWeightMedium}"/>
                    <ComboBox Grid.Column="1"
                              Width="120"
                          ItemsSource="{Binding FilmForEdit.Statuses}"
                          SelectedIndex="{Binding FilmForEdit.Status}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Grid.Column="2" 
                           Text="Рэйтинг: "
                           VerticalAlignment="Center"
                           FontWeight="{StaticResource FontWeightMedium}"/>
                    <ComboBox Grid.Column="3"
                              Width="45"
                          ItemsSource="{Binding FilmForEdit.Raitings}"
                          SelectedItem="{Binding FilmForEdit.Raiting}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                        <ComboBox.Style>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource ComboBoxForAdd_Edit}">
                                <Setter Property="IsEnabled" Value="False"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FilmForEdit.Status}" Value="2">
                                        <Setter Property="IsEnabled" Value="True"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>
                </Grid>
                <ComboBox ItemsSource="{Binding FilmForEdit.Formats}" 
                          SelectedIndex="{Binding FilmForEdit.Format}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </DockPanel>
            <ItemsControl Grid.Row="4" Grid.Column="1"
                          ItemsSource="{Binding FilmForEdit.Genres}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Left"
                                      IsChecked="{Binding Value}"/>
                            <TextBlock Text="{Binding Key.Item2}"/>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <UniformGrid Grid.Row="5" Grid.ColumnSpan="2" Rows="1">
                <Button IsDefault="True">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CheckOrCancelElementStyle}">
                            <Setter Property="Command" Value="{Binding AddElementCommand}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EditElement}" Value="True">
                                    <Setter Property="Command" Value="{Binding EditElementCommand}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button IsCancel="True" Command="{Binding CancelOperationCommand}"
                    Style="{StaticResource CheckOrCancelElementStyle}"/>
            </UniformGrid>
        </Grid>
    </Grid>
</UserControl>
