<UserControl x:Class="MyHelper.Views.UserControls.ListChallengesUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MyHelper.Views.UserControls"
             mc:Ignorable="d" 
             
             xmlns:vm="clr-namespace:MyHelper.ViewModels"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance vm:ListChallengesUCViewModel}">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <DockPanel>
        <DockPanel DockPanel.Dock="Left">
            <GroupBox DockPanel.Dock="Top" Header="Группа">
                <ComboBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}"/>
            </GroupBox>
            <UniformGrid Columns="1">
                <UniformGrid.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Margin" Value="5"/>
                    </Style>
                </UniformGrid.Resources>
                <Button Command="{Binding CreateChallengeCommand}">
                    <TextBlock TextAlignment="Center" Margin="5">Создать <LineBreak/> челлендж</TextBlock>
                </Button>
                <Button Command="{Binding EditChallengeCommand}">
                    <TextBlock TextAlignment="Center" Margin="5">Редактировать <LineBreak/> челлендж</TextBlock>
                </Button>
                <Separator/>
                <Button>
                    <TextBlock TextAlignment="Center" Margin="5">Сохранить <LineBreak/> списки</TextBlock>
                </Button>
            </UniformGrid>
        </DockPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <GroupBox Grid.Column="0" Header="Челленджи">
                <ListBox ItemsSource="{Binding ChallengesView}"
                         SelectedIndex="0"
                         SelectedItem="{Binding SelectedChallenge}"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.IsContainerVirtualizable="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Visible">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="2" BorderBrush="LightBlue"
                                    Padding="5">
                                <Grid>
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Text="{Binding Challenge, StringFormat=' Челлендж: {0}'}"/>
                                        <TextBlock Text="{Binding Duration, StringFormat=' Продолжительность: {0}'}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, 
                                                            Path=DataContext.SelectedGroup}" Value="Все">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text=" Выполняется: "/>
                                            <CheckBox IsChecked="{Binding IsProgress}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Note, StringFormat=' Примечание: {0}'}"/>
                                    </StackPanel>
                                    <Button Content="X" 
                                            VerticalAlignment="Top" HorizontalAlignment="Right"
                                            FontWeight="Bold"
                                            Background="Transparent" BorderThickness="0"
                                            Command="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, 
                                                      Path=DataContext.DeleteChallengeCommand}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Foreground" Value="Red"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter Property="Foreground" Value="Green"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>
            <GroupBox Grid.Column="1" Header="На выполнении">
                <ListBox ItemsSource="{Binding ChallengesOnProgress}"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.IsContainerVirtualizable="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Visible">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="2" BorderBrush="LightBlue"
                    Padding="5">
                                <Grid>
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Text="{Binding DateStartProgressing, StringFormat=' Дата начала: {0:dd.MM.yyyy}'}"/>
                                        <TextBlock Text="{Binding Challenge, StringFormat=' Челлендж: {0}'}"/>
                                        <TextBlock Text="{Binding Duration, StringFormat=' Продолжительность: {0}'}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, 
                    Path=DataContext.SelectedGroup}" Value="Все">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Note, StringFormat=' Примечание: {0}'}"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text=" Чек-лист:"/>
                                            <Button Content="Показать"
                                                    Command="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, 
                                                    Path=DataContext.OpenCheckListCommand}"
                                                    CommandParameter="{Binding}"
                                                    Margin="5,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>
        </Grid>
    </DockPanel>
</UserControl>
