<UserControl x:Class="MyHelper.Views.UserControls.ListChallengesUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MyHelper.Views.UserControls"
             mc:Ignorable="d" 
             xmlns:vm="clr-namespace:MyHelper.ViewModels"
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance vm:ListChallengesUCViewModel, IsDesignTimeCreatable=True}">
    <DockPanel>
        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
    </DockPanel>
</UserControl>
