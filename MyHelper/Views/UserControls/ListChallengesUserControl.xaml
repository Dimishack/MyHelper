<UserControl x:Class="MyHelper.Views.UserControls.ListChallengesUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MyHelper.Views.UserControls"
             mc:Ignorable="d" 
             
             xmlns:vm="clr-namespace:MyHelper.ViewModels"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:c="clr-namespace:MyHelper.Infrastructure.Converters"
             
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance vm:ListChallengesUCViewModel}">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <DockPanel>
        <DockPanel DockPanel.Dock="Left">
            <GroupBox DockPanel.Dock="Top" Header="Группа">
                <ComboBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}"/>
            </GroupBox>
            <UniformGrid Columns="1">
                <UniformGrid.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Margin" Value="5"/>
                    </Style>
                </UniformGrid.Resources>
                <Button Command="{Binding CreateChallengeCommand}">
                    <TextBlock TextAlignment="Center" Margin="5">Создать <LineBreak/> челлендж</TextBlock>
                </Button>
                <Button Command="{Binding EditChallengeCommand}">
                    <TextBlock TextAlignment="Center" Margin="5">Редактировать <LineBreak/> челлендж</TextBlock>
                </Button>
                <Separator/>
                <Button Command="{Binding SaveChallengesCommand}" CommandParameter="{Binding Challenges}">
                    <TextBlock TextAlignment="Center" Margin="5">Сохранить <LineBreak/> списки</TextBlock>
                </Button>
            </UniformGrid>
        </DockPanel>
        <Grid>
            <Grid.Resources>
                <Style TargetType="TextBlock" x:Key="VisDuration">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, 
            Path=DataContext.SelectedGroup}" Value="Все">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <GroupBox Grid.Column="0" Header="Челленджи">
                <ListBox ItemsSource="{Binding ChallengesView}"
                         SelectedItem="{Binding SelectedChallenge}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="2" Background="WhiteSmoke" BorderBrush="SandyBrown"
                                    Padding="5">
                                <Grid>
                                    <StackPanel Orientation="Vertical" Margin="5">
                                        <TextBlock Text="{Binding Challenge, StringFormat=' Челлендж: {0}'}"/>
                                        <TextBlock Text="{Binding Duration, StringFormat=' Продолжительность: {0}'}"
                                                   Style="{StaticResource VisDuration}"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text=" Выполняется: "/>
                                            <CheckBox IsChecked="{Binding IsProgress}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Note, StringFormat=' Примечание: {0}'}"/>
                                    </StackPanel>
                                    <Button Style="{StaticResource ForDeleteInListBoxes}"
                                            Command="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, 
                                                      Path=DataContext.DeleteChallengeCommand}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>
            <GroupBox Grid.Column="1" Header="На выполнении">
                <ListBox ItemsSource="{Binding ChallengesOnProgress}">
                    <ListBox.Resources>
                        <c:DateTimeOnBrushConverter x:Key="DateTimeOnBrush"/>
                    </ListBox.Resources>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="2" BorderBrush="SandyBrown" Padding="5"
                                    Background="{Binding Checklist, Converter={StaticResource DateTimeOnBrush}}">
                                <Grid>
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Text="{Binding DateStartProgressing, StringFormat=' Дата начала: {0:dd.MM.yyyy}'}"/>
                                        <TextBlock Text="{Binding Challenge, StringFormat=' Челлендж: {0}'}"/>
                                        <TextBlock Text="{Binding Duration, StringFormat=' Продолжительность: {0}'}"
                                                   Style="{StaticResource VisDuration}"/>
                                        <TextBlock Text="{Binding Note, StringFormat=' Примечание: {0}'}"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text=" Чек-лист:"/>
                                            <Button Content="Показать"
                                                    Command="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, 
                                                    Path=DataContext.OpenCheckListCommand}"
                                                    CommandParameter="{Binding}"
                                                    Margin="5,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>
        </Grid>
    </DockPanel>
</UserControl>
