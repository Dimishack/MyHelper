<UserControl x:Class="MyHelper.Views.UserControls.CustomFrameworkElements.PagesFE"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MyHelper.Views.UserControls.CustomFrameworkElements"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             x:Name="userControl">
    <DockPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="20,0,0,0">
            <TextBox Width="30"
                     Text="{Binding SelectedPage ,ElementName=userControl, UpdateSourceTrigger=PropertyChanged}"
                     HorizontalContentAlignment="Center" 
                     VerticalContentAlignment="Center"
                     KeyDown="TextBox_KeyDown"/>
            <TextBlock Text="{Binding LastPage, ElementName=userControl, StringFormat='/ {0}'}" 
                       VerticalAlignment="Center"
                       Margin="4,0,0,0"/>
        </StackPanel>
        <DockPanel>
            <RepeatButton DockPanel.Dock="Left" Click="OnPreviousPage"
                          Style="{StaticResource ScrollBar_LeftArrow}">
            </RepeatButton>
            <RepeatButton DockPanel.Dock="Right" Click="OnNextPage"
                          Style="{StaticResource ScrollBar_RightArrow}"/>
            <ListBox ItemsSource="{Binding Pages, ElementName=userControl}"
                 SelectedItem="{Binding CurrentPage, ElementName=userControl}"
                     Style="{StaticResource ListBoxStyle_Pages}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Padding="3"
                                   Width="20"
                                   TextAlignment="Center"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </DockPanel>
</UserControl>
