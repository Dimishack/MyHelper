<UserControl x:Class="MyHelper.Views.UserControls.ChallengesUC.StartChallengeUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MyHelper.Views.UserControls.ChallengesUC"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid VerticalAlignment="Bottom">
        <Border Style="{StaticResource BorderForAdd_EditStyle}">
            <Grid Margin="5">
                <Grid.Resources>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockForAdd_EditUC}"/>
                    <Style TargetType="TextBox" BasedOn="{StaticResource TextBoxForAdd_EditStyle}"/>
                    <Style TargetType="ComboBox" BasedOn="{StaticResource ComboBoxForAdd_Edit}">
                        <Setter Property="Margin" Value="3,2"/>
                    </Style>
                    <Style TargetType="DatePicker" BasedOn="{StaticResource DatePickerMainStyle}">
                        <Setter Property="Margin" Value="3,2"/>
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="0" Grid.Row="0" Text="Старт: "/>
                <TextBlock Grid.Column="0" Grid.Row="1" Text="Продолж.: "/>
                <TextBlock Grid.Column="0" Grid.Row="2" Text="Конец: "/>
                <TextBlock Grid.Column="0" Grid.Row="3" Text="Регулярность: "/>
                <DatePicker Grid.Column="1" Grid.Row="0"/>
                <ComboBox Grid.Column="1" Grid.Row="1">
                    <ComboBoxItem Content="123"/>
                    <ComboBoxItem Content="123"/>
                    <ComboBoxItem Content="123"/>
                    <ComboBoxItem Content="123"/>
                </ComboBox>
                <DatePicker Grid.Column="1" Grid.Row="2"/>
                <ComboBox Grid.Column="1" Grid.Row="3"/>
                <Grid Grid.ColumnSpan="2" Grid.Row="4">
                    <Grid.Resources>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockMainStyle}">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="FontWeight" Value="{StaticResource FontWeightMedium}"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="3,0"/>
                        </Style>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Каждый(-ую) " Grid.Column="0"/>
                    <ComboBox Grid.Column="1"/>
                    <TextBlock Text=" по " Grid.Column="2"/>
                    <ComboBox Grid.Column="3"/>
                    <TextBlock Text=" дня(-ей)" Grid.Column="4"/>
                </Grid>
                <UniformGrid Grid.ColumnSpan="2" Grid.Row="5" Rows="1">
                    <UniformGrid.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource CheckOrCancelElementStyle}"/>
                    </UniformGrid.Resources>
                    <Button IsDefault="True"/>
                    <Button IsCancel="True"/>
                </UniformGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
