<UserControl x:Class="MyHelper.Views.UserControls.ChallengesUC.Add_EditChallengeUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MyHelper.Views.UserControls.ChallengesUC"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:cusB="clr-namespace:MyHelper.Infrastructure.Behaviors"
             xmlns:vm="clr-namespace:MyHelper.ViewModels"
             d:DataContext="{d:DesignInstance {x:Type vm:ChallengesUCViewModel}, IsDesignTimeCreatable=True}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid VerticalAlignment="Bottom"
          Height="0">
        <i:Interaction.Behaviors>
            <cusB:Show_Add_Edit_UserControlBehavior MaxHeight="135" ManagementShow="{Binding ShowAdd_EditUserControl}"/>
        </i:Interaction.Behaviors>
        <Border Style="{StaticResource BorderForAdd_EditStyle}"/>
        <Grid Margin="5" >
            <Grid.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockForAdd_EditUC}"/>
                <Style TargetType="TextBox" BasedOn="{StaticResource TextBoxForAdd_EditStyle}"/>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="Название:"/>
            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="Примечание:"/>
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ChallengeForAdd_Edit.Name}"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ChallengeForAdd_Edit.Note}"/>
            <UniformGrid Rows="1" Grid.Row="2" Grid.ColumnSpan="2">
                <UniformGrid.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource CheckOrCancelElementStyle}"/>
                </UniformGrid.Resources>
                <Button IsDefault="True" Command="{Binding AddChallengeCommand}"/>
                <Button IsCancel="True" Command="{Binding CancelAdd_EditCommand}"/>
            </UniformGrid>
        </Grid>
    </Grid>
</UserControl>
