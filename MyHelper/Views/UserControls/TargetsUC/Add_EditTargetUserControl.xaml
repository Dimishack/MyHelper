<UserControl x:Class="MyHelper.Views.UserControls.TargetsUC.Add_EditTargetUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MyHelper.Views.UserControls"
             mc:Ignorable="d"
             xmlns:vm="clr-namespace:MyHelper.ViewModels"
             d:DataContext="{d:DesignInstance {x:Type vm:TargetsUCViewModel}, IsDesignTimeCreatable=True}"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Storyboard x:Key="ShowUserControl">
            <DoubleAnimation Storyboard.TargetProperty="Height"
                             To="150"
                             BeginTime="0:0:0"
                             Duration="0:0:0.7"
                             AccelerationRatio="0.5">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="HideUserControl">
            <DoubleAnimation Storyboard.TargetProperty="Height"
                             To="0"
                             BeginTime="0:0:0"
                             Duration="0:0:0.7"
                             AccelerationRatio="0.5">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>
    <Grid Height="0" VerticalAlignment="Bottom">
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsVisibleAdd_EditTarget}" Value="True">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard Storyboard="{StaticResource ShowUserControl}"/>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <BeginStoryboard Storyboard="{StaticResource HideUserControl}"/>
                        </DataTrigger.ExitActions>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Border Background="White" BorderBrush="Black"
                BorderThickness="2,2,2,0"
                CornerRadius="4,4,0,0"/>
        <Grid Margin="0,5,0,0">
            <Grid.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Margin" Value="3"/>
                    <Setter Property="FontWeight" Value="Medium"/>
                    <Setter Property="HorizontalAlignment" Value="Right"/>
                </Style>
                <Style TargetType="TextBox">
                    <Setter Property="Margin" Value="3"/>
                </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0"
                   Text="Цель:"/>
            <TextBlock Grid.Row="1" Grid.Column="0"
                   Text="Примечание:"/>
            <TextBlock Grid.Row="2" Grid.Column="0"
                   Text="Выполнена:"/>
            <TextBox Grid.Row="0" Grid.Column="1"
                 Text="{Binding TargetForAdd_Edit.Name, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBox Grid.Row="1" Grid.Column="1"
                 Text="{Binding TargetForAdd_Edit.Note, UpdateSourceTrigger=PropertyChanged}"/>
            <CheckBox Grid.Row="2" Grid.Column="1"
                  IsChecked="{Binding TargetForAdd_Edit.IsComplete}"
                      VerticalAlignment="Center" Margin="3"/>
            <UniformGrid Rows="1" Grid.ColumnSpan="2" Grid.Row="3">
                <Button IsDefault="True">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ForUGInCreator_Editors}">
                            <Setter Property="Command" Value="{Binding CreateTargetCommand}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ChangeTarget}" Value="True">
                                    <Setter Property="Command" Value="{Binding ChangeTargetCommand}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button IsCancel="True" Style="{StaticResource ForUGInCreator_Editors}"
                        Command="{Binding CancelCreate_EditTargetCommand}"/>
            </UniformGrid>
        </Grid>
    </Grid>
</UserControl>
