<UserControl x:Class="MyHelper.Views.UserControls.TargetsUC.Add_EditTargetUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MyHelper.Views.UserControls"
             mc:Ignorable="d"
             xmlns:vm="clr-namespace:MyHelper.ViewModels"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:cusB="clr-namespace:MyHelper.Infrastructure.Behaviors"
             d:DataContext="{d:DesignInstance {x:Type vm:TargetsUCViewModel}, IsDesignTimeCreatable=True}"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Height="0" VerticalAlignment="Bottom">
        <i:Interaction.Behaviors>
            <cusB:Show_Add_Edit_UserControlBehavior MaxHeight="135" ManagementShow="{Binding IsVisibleAdd_EditTarget}"/>
        </i:Interaction.Behaviors>
        <Border Style="{StaticResource BorderForAdd_EditStyle}"/>
        <Grid Margin="5">
            <Grid.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockForAdd_EditUC}"/>
                <Style TargetType="TextBox" BasedOn="{StaticResource TextBoxForAdd_EditStyle}"/>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0"
                   Text="Цель:"/>
            <TextBlock Grid.Row="1" Grid.Column="0"
                   Text="Примечание:"/>
            <TextBox x:Name="tb_Name" Grid.Row="0" Grid.Column="1"
                 Text="{Binding TargetForAdd_Edit.Name, UpdateSourceTrigger=PropertyChanged}">
            </TextBox>
            <TextBox Grid.Row="1" Grid.Column="1"
                 Text="{Binding TargetForAdd_Edit.Note, UpdateSourceTrigger=PropertyChanged}"/>
            <UniformGrid Rows="1" Grid.ColumnSpan="2" Grid.Row="2">
                <Button IsDefault="True">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CheckOrCancelElementStyle}">
                            <Setter Property="Command" Value="{Binding CreateTargetCommand}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ChangeTarget}" Value="True">
                                    <Setter Property="Command" Value="{Binding ChangeTargetCommand}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button IsCancel="True" Style="{StaticResource CheckOrCancelElementStyle}"
                        Command="{Binding CancelCreate_EditTargetCommand}"/>
            </UniformGrid>
        </Grid>
    </Grid>
</UserControl>
