<UserControl x:Class="MyHelper.Views.UserControls.TargetsUC.Add_EditGroupTargetsUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MyHelper.Views.UserControls"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:cusB="clr-namespace:MyHelper.Infrastructure.Behaviors"
             mc:Ignorable="d" d:DesignWidth="300" Height="110">
    <Grid Height="0" VerticalAlignment="Bottom">
        <i:Interaction.Behaviors>
            <cusB:Show_Add_Edit_UserControlBehavior MaxHeight="110" ManagementShow="{Binding IsVisibleAdd_EditGroup}"/>
        </i:Interaction.Behaviors>
        <Border Background="White" BorderThickness="2,2,2,0" 
                BorderBrush="Black"
                CornerRadius="4,4,0,0"></Border>
        <Grid Margin="3">
            <Grid.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Margin" Value="3"/>
                    <Setter Property="HorizontalAlignment" Value="Right"/>
                    <Setter Property="FontWeight" Value="Medium"/>
                </Style>
                <Style TargetType="TextBox">
                    <Setter Property="Margin" Value="3"/>
                </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Год: "/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Название группы: "/>
            <TextBlock Grid.Row="0" Grid.Column="1"
                       Text="{Binding TargetsGroupForAdd_Edit.Year}"
                       HorizontalAlignment="Left"
                       />
            <TextBox x:Name="tb_Name" Grid.Row="1" Grid.Column="1"
                     Text="{Binding TargetsGroupForAdd_Edit.Name, UpdateSourceTrigger=PropertyChanged}"/>
            <UniformGrid Grid.Row="2" Grid.ColumnSpan="2" Rows="1">
                <UniformGrid.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource ForUGInCreator_Editors}">
                        <Setter Property="Padding" Value="3"/>
                    </Style>
                </UniformGrid.Resources>
                <Button IsDefault="True">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ForUGInCreator_Editors}">
                            <Setter Property="Padding" Value="3"/>
                            <Setter Property="Command" Value="{Binding CreateGroupCommand}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ChangeGroup}" Value="True">
                                    <Setter Property="Command" Value="{Binding ChangeGroupCommand}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button IsCancel="True" Command="{Binding CancelCreateGroupCommand}"/>
            </UniformGrid>
        </Grid>
    </Grid>
</UserControl>
