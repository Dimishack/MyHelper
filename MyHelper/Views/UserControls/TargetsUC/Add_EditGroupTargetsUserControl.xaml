<UserControl x:Class="MyHelper.Views.UserControls.TargetsUC.Add_EditGroupTargetsUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MyHelper.Views.UserControls"
             
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:cusB="clr-namespace:MyHelper.Infrastructure.Behaviors"
             
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">
    <Grid Height="0" VerticalAlignment="Bottom">
        <i:Interaction.Behaviors>
            <cusB:ShowAdditionalUserControl MaxHeight="115" ManagementShow="{Binding IsShowEditorUC}"/>
        </i:Interaction.Behaviors>
        <Border Style="{StaticResource BorderStyle_AdditionalUserControl}"/>
        <Grid Margin="5">
            <Grid.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockStyle_AdditionalUserControl}"/>
                <Style TargetType="TextBox" BasedOn="{StaticResource TextBoxStyle_AdditionalUserControl}"/>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Год: "/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Название группы: "/>
            <TextBlock Grid.Row="0" Grid.Column="1"
                       Text="{Binding TargetsGroupForAdd_Edit.Year}"
                       HorizontalAlignment="Left"
                       />
            <TextBox x:Name="tb_Name" Grid.Row="1" Grid.Column="1"
                     Text="{Binding TargetsGroupForAdd_Edit.Name, UpdateSourceTrigger=PropertyChanged}"/>
            <UniformGrid Grid.Row="2" Grid.ColumnSpan="2" Rows="1">
                <Button IsDefault="True">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CheckOrCancelElementStyle}">
                            <Setter Property="Command" Value="{Binding AddElementCommand}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditingElement}" Value="True">
                                    <Setter Property="Command" Value="{Binding EditElementCommand}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button IsCancel="True" Command="{Binding CancelOperationCommand}"
                        Style="{StaticResource CheckOrCancelElementStyle}"/>
            </UniformGrid>
        </Grid>
    </Grid>
</UserControl>
