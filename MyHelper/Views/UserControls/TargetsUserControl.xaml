<UserControl x:Class="MyHelper.Views.UserControls.TargetsUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MyHelper.Views.UserControls"
             xmlns:targetsUC="clr-namespace:MyHelper.Views.UserControls.TargetsUC"
             
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:vm="clr-namespace:MyHelper.ViewModels"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             
             d:DataContext="{d:DesignInstance vm:TargetsUCViewModel,IsDesignTimeCreatable=True}"
             d:DesignHeight="450" d:DesignWidth="700"
             x:Name="userControl"
             MinHeight="300">
    <UserControl.RenderTransform>
        <TranslateTransform X="0"
                            Y="0"/>
    </UserControl.RenderTransform>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                     From="-10"
                                     To="0"
                                     AccelerationRatio="0.9"
                                     BeginTime="0:0:0"
                                     Duration="0:0:0.3"/>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0"
                                     To="1"
                                     BeginTime="0:0:0"
                                     Duration="0:0:0.3"/>

                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <GroupBox Grid.Column="2" Header="Года" Width="70" Panel.ZIndex="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <UniformGrid Grid.Row="1" Columns="1">
                    <UniformGrid.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Margin" Value="2"/>
                            <Setter Property="Padding" Value="3"/>
                        </Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Margin" Value="2"/>
                            <Setter Property="Padding" Value="3"/>
                        </Style>
                    </UniformGrid.Resources>
                    <ToggleButton IsChecked="{Binding AddGroup}"
                                  IsEnabled="{Binding EnableToggleButtons}">
                        <fa:IconImage Style="{StaticResource AddFAStyle}"/>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding ChangeGroup}" 
                                  IsEnabled="{Binding EnableToggleButtonChangeGroup}">
                        <fa:IconImage Style="{StaticResource EditFAStyle}"/>
                    </ToggleButton>
                    <Button Command="{Binding RemoveTargetsGroupCommand}">
                        <fa:IconImage Style="{StaticResource RemoveFAStyle}"/>
                    </Button>
                    <Button>
                        <Button.Style>
                            <Style TargetType="Button">
                                
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <fa:IconImage Style="{StaticResource SaveFAStyle}"/>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AutoSave}" Value="True">
                                        <Setter Property="Content">
                                            <Setter.Value>
                                                <TextBlock Text="Автосохр." FontSize="10"/>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </UniformGrid>
                <ListBox ItemsSource="{Binding GroupsTargets}"
                         SelectedItem="{Binding SelectedTargetsGroup}"
                         DisplayMemberPath="Year"/>
            </Grid>
        </GroupBox>
        <DockPanel Grid.Column="0" Width="135">
            <GroupBox DockPanel.Dock="Top" Header="Сортировка">
                <ComboBox ItemsSource="{Binding Sorts}"
                          SelectedItem="{Binding SelectedSort}"
                          SelectedIndex="0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Key}"
                                       TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </GroupBox>
            <GroupBox Header="Фильтр">
                <StackPanel Orientation="Vertical">
                    <StackPanel.Resources>
                        <Style TargetType="RadioButton">
                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Resources>
                    <RadioButton Content="Все" Command="{Binding FilterCommand}"
                                 CommandParameter="Все" IsChecked="True"/>
                    <RadioButton Content="Выполненные" Command="{Binding FilterCommand}"
                                 CommandParameter="Выполненные"/>
                    <RadioButton Content="Невыполненные" Command="{Binding FilterCommand}"
                                 CommandParameter="Невыполненные"/>
                </StackPanel>
            </GroupBox>
        </DockPanel>
        <GroupBox Header="{Binding SelectedTargetsGroup.Name, FallbackValue='Выберите год'}"
                  Grid.Column="1" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Vertical"
                            Background="White" Grid.Row="2" Panel.ZIndex="2">
                    <TextBlock Text="{Binding SelectedTargetsGroup.CompletedTargetsCount, StringFormat='Количество выполненных целей: {0}'}"/>
                    <TextBlock Text="{Binding SelectedTargetsGroup.Targets.Count, StringFormat='Количество целей: {0}'}"/>
                    <StackPanel Orientation="Horizontal" Panel.ZIndex="2">
                        <TextBlock Text="Автосохранение: "/>
                        <CheckBox IsChecked="{Binding AutoSave}"/>
                    </StackPanel>
                </StackPanel>
                <UniformGrid DockPanel.Dock="Bottom" Rows="1" Background="White"
                             Grid.Row="1" Panel.ZIndex="2">
                    <ToggleButton IsChecked="{Binding AddTarget}"
                                  IsEnabled="{Binding EnableToggleButtons}">
                        <fa:IconImage Style="{StaticResource AddFAStyle}"/>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding ChangeTarget}"
                                  IsEnabled="{Binding EnableToggleButtonChangeTarget}">
                        <fa:IconImage Style="{StaticResource EditFAStyle}"/>
                    </ToggleButton>
                    <Button Command="{Binding RemoveTargetCommand}">
                        <fa:IconImage Style="{StaticResource RemoveFAStyle}"/>
                    </Button>
                </UniformGrid>
                <ListBox ItemsSource="{Binding SelectedTargetsView}"
                         SelectedItem="{Binding SelectedTarget}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="{Binding Name}"/>
                                <CheckBox IsChecked="{Binding IsComplete}" HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding Note}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <targetsUC:Add_EditGroupTargetsUserControl Grid.Row="0"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Bottom"
                                                  Panel.ZIndex="1"/>
                <targetsUC:Add_EditTargetUserControl Grid.Row="0"
                                                 HorizontalAlignment="Stretch"
                                                 VerticalAlignment="Bottom"
                                                 Panel.ZIndex="1"/>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
