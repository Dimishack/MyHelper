<UserControl x:Class="MyHelper.Views.UserControls.TargetsUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MyHelper.Views.UserControls"
             
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:fa5="http://schemas.fontawesome.com/icons/"
             xmlns:vm="clr-namespace:MyHelper.ViewModels"
             
             d:DataContext="{d:DesignInstance vm:TartetsUCViewModel,IsDesignTimeCreatable=True}"
             d:DesignHeight="450" d:DesignWidth="700"
             x:Name="userControl"
             MinHeight="300">
    <UserControl.RenderTransform>
        <TranslateTransform X="0"
                            Y="0"/>
    </UserControl.RenderTransform>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                     From="-10"
                                     To="0"
                                     AccelerationRatio="0.9"
                                     BeginTime="0:0:0"
                                     Duration="0:0:0.3"/>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0"
                                     To="1"
                                     BeginTime="0:0:0"
                                     Duration="0:0:0.3"/>

                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <DockPanel>
        <GroupBox DockPanel.Dock="Right" Header="Года" Width="70">
            <DockPanel>
                <UniformGrid DockPanel.Dock="Bottom" Columns="1">
                    <UniformGrid.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Margin" Value="2"/>
                            <Setter Property="Padding" Value="3"/>
                        </Style>
                    </UniformGrid.Resources>
                    <Button Command="{Binding CreateTargetsGroupCommand}">
                        <fa5:ImageAwesome Style="{StaticResource AddImage}"/>
                    </Button>
                    <Button Command="{Binding ChangeTargetsGroupCommand}">
                        <fa5:ImageAwesome Style="{StaticResource EditImage}"/>
                    </Button>
                    <Button Command="{Binding RemoveTargetsGroupCommand}">
                        <fa5:ImageAwesome Style="{StaticResource RemoveImage}"/>
                    </Button>
                    <Button>
                        <fa5:ImageAwesome Style="{StaticResource SaveImage}"/>
                    </Button>
                </UniformGrid>
                <ListBox ItemsSource="{Binding GroupsTargets}"
                         SelectedItem="{Binding SelectedTargets}"
                         SelectedIndex="0"
                         DisplayMemberPath="Year"/>
            </DockPanel>
        </GroupBox>
        <DockPanel DockPanel.Dock="Left" Width="125">
            <GroupBox DockPanel.Dock="Top" Header="Сортировка">
                <ComboBox ItemsSource="{Binding Sorts}"
                          SelectedItem="{Binding SelectedSort}"
                          SelectedIndex="0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Key}"
                                       TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </GroupBox>
            <GroupBox Header="Фильтр">
                <StackPanel Orientation="Vertical">
                    <StackPanel.Resources>
                        <Style TargetType="RadioButton">
                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Resources>
                    <RadioButton Content="Все" Command="{Binding FilterCommand}"
                                 CommandParameter="Все" IsChecked="True"/>
                    <RadioButton Content="Выполненные" Command="{Binding FilterCommand}"
                                 CommandParameter="Выполненные"/>
                    <RadioButton Content="Невыполненные" Command="{Binding FilterCommand}"
                                 CommandParameter="Невыполненные"/>
                </StackPanel>
            </GroupBox>
        </DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Vertical">
            <TextBlock Text="{Binding SelectedTargets.CompletedTargetsCount, StringFormat='Количество выполненных целей: {0}'}"/>
            <TextBlock Text="{Binding SelectedTargets.Targets.Count, StringFormat='Количество целей: {0}'}"/>
        </StackPanel>
        <GroupBox Header="{Binding SelectedTargets.Name, FallbackValue='Выберите год'}">
            <DockPanel>
                <UniformGrid DockPanel.Dock="Bottom" Rows="1">
                    <UniformGrid.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Margin" Value="2"/>
                            <Setter Property="Padding" Value="3"/>
                        </Style>
                    </UniformGrid.Resources>
                    <Button>
                        <fa5:ImageAwesome Style="{StaticResource AddImage}"/>
                    </Button>
                    <Button>
                        <fa5:ImageAwesome Style="{StaticResource EditImage}"/>
                    </Button>
                </UniformGrid>
                <ListBox ItemsSource="{Binding SelectedTargetsView}" Focusable="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="{Binding Name}"/>
                                <CheckBox IsChecked="{Binding IsComplete}"/>
                                <TextBlock Text="{Binding Note}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </GroupBox>
    </DockPanel>
</UserControl>
