<UserControl x:Class="MyHelper.Views.UserControls.TargetsUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MyHelper.Views.UserControls"
             xmlns:targetsUC="clr-namespace:MyHelper.Views.UserControls.TargetsUC"
             
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:vm="clr-namespace:MyHelper.ViewModels"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             xmlns:cusB="clr-namespace:MyHelper.Infrastructure.Behaviors"
             
             d:DataContext="{d:DesignInstance vm:TargetsUCViewModel,IsDesignTimeCreatable=True}"
             d:DesignHeight="450" d:DesignWidth="700"
             MinHeight="300">
    <UserControl.RenderTransform>
        <TranslateTransform X="0"
                            Y="0"/>
    </UserControl.RenderTransform>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                     From="-10"
                                     To="0"
                                     AccelerationRatio="0.9"
                                     BeginTime="0:0:0"
                                     Duration="0:0:0.3"/>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0"
                                     To="1"
                                     BeginTime="0:0:0"
                                     Duration="0:0:0.3"/>

                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadCommand}"/>
        </i:EventTrigger>
        <i:EventTrigger EventName="Unloaded">
            <i:InvokeCommandAction Command="{Binding ClosedCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid Background="#FFD700">
        <Grid.Resources>
            <Style TargetType="Button">
                <Setter Property="Margin" Value="2"/>
                <Setter Property="Padding" Value="3"/>
            </Style>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <GroupBox Grid.Column="2" Header="Года" Width="70" Panel.ZIndex="2"
                  BorderThickness="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <UniformGrid Grid.Row="1" Columns="1" Margin="0,5,0,0">
                    <UniformGrid.Resources>
                    </UniformGrid.Resources>
                    <ToggleButton IsChecked="{Binding AddGroup}"
                                  IsEnabled="{Binding EnableToggleButtons}"
                                  Style="{StaticResource AddElementStyle}"
                                  Margin="1"/>
                    <ToggleButton IsChecked="{Binding ChangeGroup}" 
                                  IsEnabled="{Binding EnableToggleButtonChangeGroup}"
                                  Style="{StaticResource EditElementStyle}"
                                  Margin="1"/>
                    <Button Command="{Binding RemoveTargetsGroupCommand}"
                            Style="{StaticResource DeleteElementStyle}"
                            Margin="1"/>
                    <Button Style="{StaticResource ButtonSaveStyle}"
                            FontSize="10"
                            Command="{Binding SaveRepositoryCommand}"/>
                </UniformGrid>
                <ListBox ItemsSource="{Binding GroupsTargets}"
                         SelectedItem="{Binding SelectedTargetsGroup}"
                         DisplayMemberPath="Year"/>
            </Grid>
        </GroupBox>
        <DockPanel Grid.Column="0" Width="135">
            <GroupBox DockPanel.Dock="Top" Header="Сортировка" BorderThickness="0">
                <ComboBox ItemsSource="{Binding Sorts}"
                          SelectedItem="{Binding SelectedSort}"
                          SelectedIndex="0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Key}"
                                       TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </GroupBox>
            <GroupBox Header="Фильтр" BorderThickness="0">
                <StackPanel Orientation="Vertical">
                    <StackPanel.Resources>
                        <Style TargetType="RadioButton">
                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Resources>
                    <RadioButton Content="Все" Command="{Binding FilterCommand}"
                                 CommandParameter="Все" IsChecked="True"/>
                    <RadioButton Content="Выполненные" Command="{Binding FilterCommand}"
                                 CommandParameter="Выполненные"/>
                    <RadioButton Content="Невыполненные" Command="{Binding FilterCommand}"
                                 CommandParameter="Невыполненные"/>
                </StackPanel>
            </GroupBox>
        </DockPanel>
        <GroupBox Header="{Binding SelectedTargetsGroup.Name, FallbackValue='Выберите год'}"
                  Grid.Column="1" Background="Transparent" BorderThickness="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="2" Panel.ZIndex="2" Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0">
                        <Run Text="Выполненных/Всего: "/>
                        <Run Text="{Binding SelectedTargetsGroup.CompletedTargetsCount
                                    ,StringFormat='{}{0:00}', Mode=OneWay}"/>
                        <Run Text="/"/>
                        <Run Text="{Binding SelectedTargetsGroup.Targets.Count
                                    ,StringFormat='{}{0:00}', Mode=OneWay}"/>
                    </TextBlock>
                    <Border Grid.Column="1" Background="Black" Margin="4,0"/>
                    <ProgressBar Grid.Column="2"
                                 Maximum="1" Background="#e1cc4f" BorderThickness="0">
                        <i:Interaction.Behaviors>
                            <cusB:ProgressBehavior Progress="{Binding SelectedTargetsGroup.Progress}"/>
                        </i:Interaction.Behaviors>
                        <ProgressBar.Foreground>
                            <LinearGradientBrush>
                                <GradientStop Color="Yellow" Offset="0"/>
                                <GradientStop x:Name="Grelka" Color="Green">
                                    <i:Interaction.Behaviors>
                                        <cusB:OffsetOfCompleteBehavior OffsetOfComplete="{Binding SelectedTargetsGroup.OffsetOfCompleted}"/>
                                    </i:Interaction.Behaviors>
                                </GradientStop>
                            </LinearGradientBrush>
                        </ProgressBar.Foreground>
                    </ProgressBar>
                    <TextBlock Grid.Column="2" Text="{Binding SelectedTargetsGroup.Procent, StringFormat='{}{0:00.00}%', TargetNullValue=0}" HorizontalAlignment="Center"/>
                </Grid>
                <UniformGrid DockPanel.Dock="Bottom" Rows="1"
                             Grid.Row="1" Panel.ZIndex="2">
                    <ToggleButton IsChecked="{Binding AddTarget}"
                                  IsEnabled="{Binding EnableToggleButtonCreateTarget}"
                                  Style="{StaticResource AddElementStyle}"/>
                    <ToggleButton IsChecked="{Binding ChangeTarget}"
                                  IsEnabled="{Binding EnableToggleButtonChangeTarget}"
                                  Style="{StaticResource EditElementStyle}"/>
                    <Button Command="{Binding RemoveTargetCommand}"
                            Style="{StaticResource DeleteElementStyle}"/>
                </UniformGrid>
                <ListBox ItemsSource="{Binding SelectedTargetsView}"
                         SelectedItem="{Binding SelectedTarget}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical" Background="#FAF0E6" Margin="2">
                                <StackPanel.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Margin" Value="3,2"/>
                                    </Style>
                                </StackPanel.Resources>
                                <TextBlock Text="{Binding Name, StringFormat='Цель: {0}'}"
                                           FontWeight="Bold"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Выполнена: "/>
                                    <CheckBox IsChecked="{Binding IsComplete}" HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Note, StringFormat='Примечание: {0}'}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <targetsUC:Add_EditGroupTargetsUserControl Grid.Row="0"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Bottom"
                                                  Panel.ZIndex="1"/>
                <targetsUC:Add_EditTargetUserControl Grid.Row="0"
                                                 HorizontalAlignment="Stretch"
                                                 VerticalAlignment="Bottom"
                                                 Panel.ZIndex="1"/>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
