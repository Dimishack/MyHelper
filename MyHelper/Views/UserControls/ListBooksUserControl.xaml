<UserControl x:Class="MyHelper.Views.UserControls.ListBooksUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MyHelper.Views.UserControls"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:vm="clr-namespace:MyHelper.ViewModels"
             
             d:DataContext="{d:DesignInstance {x:Type vm:ListBooksUCViewModel}}"
             d:DesignHeight="450" d:DesignWidth="800">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedWindowCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <DockPanel>
        <UniformGrid DockPanel.Dock="Right" Columns="1" Margin="5">
            <UniformGrid.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource ForPanels}"/>
                <Style TargetType="TextBlock" BasedOn="{StaticResource ForPanelsInButton}"/>
            </UniformGrid.Resources>
            <Button Content="Добавить книгу"
                    Command="{Binding AddBookCommand}"/>
            <Button Command="{Binding EditBookCommand}" CommandParameter="{Binding SelectedBook}">
                <TextBlock TextAlignment="Center">Редактировать<LineBreak/>книгу</TextBlock>
            </Button>
            <Separator/>
            <Button Command="{Binding SaveBooksCommand}" CommandParameter="{Binding ListBooks}">
                <TextBlock TextAlignment="Center">Сохранить<LineBreak/>список книг</TextBlock>
            </Button>
        </UniformGrid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30*" MinHeight="20"/>
                <RowDefinition Height="3"/>
                <RowDefinition Height="60*" MinHeight="20"/>
            </Grid.RowDefinitions>
            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            <GroupBox Grid.Row="0" Header="На прочтении">
                <ListBox ItemsSource="{Binding ListBooksOnReading}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="1" BorderBrush="SandyBrown" Background="WhiteSmoke">
                                <Grid Margin="5">
                                    <StackPanel Orientation="Vertical" Margin="5,3,15,3">
                                        <TextBlock Text="{Binding Author, StringFormat='Автор: {0}'}"/>
                                        <TextBlock Text="{Binding Name, StringFormat='Название: {0}'}"/>
                                        <TextBlock Text="{Binding Pages, StringFormat='Кол-во страниц: {0:N0}'}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>
            <GroupBox Grid.Row="2">
                <GroupBox.Header>
                    <TextBlock Text="{Binding ListBooks.Count, StringFormat='Список всех книг ({0})'}"/>
                </GroupBox.Header>
                <ListBox ItemsSource="{Binding ListBooks}" SelectedItem="{Binding SelectedBook}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="1" BorderBrush="SandyBrown">
                                <Border.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="WhiteSmoke"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsReaded}" Value="True">
                                                <Setter Property="Background" Value="LightGreen"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Resources>
                                <Grid Margin="5">
                                    <StackPanel Orientation="Vertical" Margin="5,3,15,3">
                                        <TextBlock Text="{Binding Author, StringFormat='Автор: {0}'}"/>
                                        <TextBlock Text="{Binding Name, StringFormat='Название: {0}'}"/>
                                        <TextBlock Text="{Binding Pages, StringFormat='Кол-во страниц: {0:N0}'}"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Прочитана/Читается: "/>
                                            <CheckBox IsChecked="{Binding IsReaded, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Text="/"/>
                                            <CheckBox IsChecked="{Binding IsReading, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Style="{StaticResource ForDeleteInListBoxes}"
                                            Command="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, 
                                        Path=DataContext.DeleteBookCommand}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>
        </Grid>
    </DockPanel>
</UserControl>
