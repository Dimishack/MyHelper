<UserControl x:Class="MyHelper.Views.UserControls.TasksUC.Add_EditTaskUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MyHelper.Views.UserControls.TasksUC"
             
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:cusB="clr-namespace:MyHelper.Infrastructure.Behaviors"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid VerticalAlignment="Bottom" Height="0">
        <i:Interaction.Behaviors>
            <cusB:ShowAdditionalUserControl MaxHeight="220" 
                                            ManagementShow="{Binding IsShowEditorUC}"/>
        </i:Interaction.Behaviors>
        <Border Style="{StaticResource BorderStyle_AdditionalUserControl}"/>
        <Grid Margin="5">
            <Grid.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockStyle_AdditionalUserControl}"/>
                <Style TargetType="TextBox" BasedOn="{StaticResource TextBoxStyle_AdditionalUserControl}"/>
                <Style TargetType="CheckBox" BasedOn="{StaticResource CheckBoxStyle_AdditionalUserControl}"/>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="Задача: "/>
            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="Приоритет: "/>
            <TextBlock Grid.Row="2" Grid.Column="0"
                       Text="Группа: "/>
            <TextBlock Grid.Row="3" Grid.Column="0"
                       Text="Срок: "/>
            <TextBlock Grid.Row="4" Grid.Column="0"
                       Text="Примечание: "/>
            <TextBox Grid.Row="0" Grid.Column="1"
                     x:Name="tb_Name"
                     Text="{Binding TaskForAdd_Edit.Name, UpdateSourceTrigger=PropertyChanged}"/>
            <StackPanel Orientation="Horizontal"
                        Grid.Row="1" Grid.Column="1"
                        Margin="3,0,0,0">
                <TextBlock Text="Важный: "/>
                <CheckBox IsChecked="{Binding TaskForAdd_Edit.Important}"/>
                <TextBlock Text="Срочный: "/>
                <CheckBox IsChecked="{Binding TaskForAdd_Edit.Prompt}"/>
            </StackPanel>
            <Grid Grid.Row="2" Grid.Column="1"
                  Margin="5,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>
                <ComboBox Style="{StaticResource ComboBoxForAdd_Edit}"
                          Margin="2,5"
                          ItemsSource="{Binding Keys}"
                          SelectedItem="{Binding TaskForAdd_Edit.Group}"
                          Grid.Column="0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                   FontWeight="{StaticResource FontWeightBold}"
                                   Margin="2,0"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="1"
                        Command="{Binding AddGroupCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CheckOrCancelElementStyle}">
                            <Setter Property="fa:IconImage.Icon" Value="Add"/>
                            <Setter Property="Margin" Value="2,2.5"/>
                            <Setter Property="Padding" Value="3"/>
                        </Style>
                    </Button.Style>
                </Button>
                <TextBox Grid.Column="2" Margin="1,3,2,3"
                         Text="{Binding NewGroup, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
            <DatePicker Grid.Row="3" Grid.Column="1"
                        Margin="5,3,9,3"
                        Style="{StaticResource DatePickerMainStyle}"
                        SelectedDate="{Binding TaskForAdd_Edit.End}">
                <i:Interaction.Behaviors>
                    <cusB:BlackoutDatesForStartChallengeBehavior/>
                </i:Interaction.Behaviors>
            </DatePicker>
            <TextBox Grid.Row="4" Grid.Column="1"
                     Text="{Binding TaskForAdd_Edit.Note, UpdateSourceTrigger=PropertyChanged}"/>
            <UniformGrid Rows="1" Grid.Row="5" Grid.ColumnSpan="2">
                <Button IsDefault="True">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CheckOrCancelElementStyle}">
                            <Setter Property="Command" Value="{Binding AddElementCommand}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditingElement}" Value="True">
                                    <Setter Property="Command" Value="{Binding EditElementCommand}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Style="{StaticResource CheckOrCancelElementStyle}"
                        IsCancel="True"
                        Command="{Binding CancelOperationCommand}"/>
            </UniformGrid>
        </Grid>
    </Grid>
</UserControl>
