<UserControl x:Class="MyHelper.Views.UserControls.ListPurposesUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MyHelper.Views.UserControls"
             
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:fa5="http://schemas.fontawesome.com/icons/"
             xmlns:vm="clr-namespace:MyHelper.ViewModels"
             
             d:DataContext="{d:DesignInstance vm:ListPurposesUserControlViewModel}"
             d:DesignHeight="450" d:DesignWidth="800"
             MinHeight="300">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <DockPanel>
        <DockPanel.Resources>
            <Style TargetType="ListBox">
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible"/>
                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
                <Setter Property="VirtualizingPanel.IsContainerVirtualizable" Value="True"/>
                <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
                <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </DockPanel.Resources>
        <GroupBox DockPanel.Dock="Left" Header="Года">
            <DockPanel>
                <UniformGrid DockPanel.Dock="Bottom" Columns="1">
                    <UniformGrid.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Padding" Value="3"/>
                            <Setter Property="Margin" Value="1,3"/>
                            <Setter Property="Height" Value="20"/>
                        </Style>
                    </UniformGrid.Resources>
                    <Button Command="{Binding CreateNewYearCommand}">
                        <fa5:ImageAwesome Icon="Solid_Plus" Foreground="Green"/>
                    </Button>
                    <Button Command="{Binding EditYearCommand}">
                        <fa5:ImageAwesome Icon="Solid_Edit" Foreground="Blue"/>
                    </Button>
                    <Button Command="{Binding DeleteYearCommand}">
                        <fa5:ImageAwesome Icon="Solid_Minus" Width="12" Foreground="Red"/>
                    </Button>
                </UniformGrid>
                <ListBox ItemsSource="{Binding ListMyPurposes}" SelectedItem="{Binding SelectedListMyPurposes}" SelectedIndex="0"
                     DisplayMemberPath="Year"/>
            </DockPanel>
        </GroupBox>
        <DockPanel DockPanel.Dock="Right" MaxWidth="150">
            <GroupBox DockPanel.Dock="Top" Header="Сортировка">
                <ComboBox ItemsSource="{Binding Sorting.Keys}" SelectedItem="{Binding SelectedSorting}"/>
            </GroupBox>
            <UniformGrid Columns="1">
                <UniformGrid.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Margin" Value="3,5"/>
                    </Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="TextAlignment" Value="Center"/>
                    </Style>
                </UniformGrid.Resources>
                <Button Content="Создать цель" 
                            Command="{Binding CreateNewPurposeCommand}"/>
                <Button Content="Редактировать цель" 
                            Command="{Binding EditMyPurposeCommand}"/>
                <Separator/>
                <Button Command="{Binding SaveListMyPurposesCommand}" CommandParameter="{Binding ListMyPurposes}">
                    <TextBlock>Сохранить <LineBreak/> списки целей</TextBlock>
                </Button>
            </UniformGrid>
        </DockPanel>
        <GroupBox Header="{Binding SelectedListMyPurposes.Name, FallbackValue='Выберите год'}">
            <DockPanel>
                <Grid DockPanel.Dock="Bottom" Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="3,0,10,0">
                        <StackPanel.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="14"/>
                            </Style>
                        </StackPanel.Resources>
                        <TextBlock Text="{Binding CompletingMyPurposesCount, StringFormat='Выполненных/Всего: {0}/'}"/>
                        <TextBlock Text="{Binding MyPurposesCount}"/>
                    </StackPanel>
                    <ProgressBar Grid.Column="1" Maximum="1" Value="{Binding Percent, Mode=OneWay}">
                        <ProgressBar.Foreground>
                            <LinearGradientBrush>
                                <GradientStop Color="Red" Offset="0"/>
                                <GradientStop Color="LimeGreen" Offset="{Binding OffsetLimeGreenColor, Mode=OneWay}"/>
                            </LinearGradientBrush>
                        </ProgressBar.Foreground>
                    </ProgressBar>
                    <TextBlock Grid.Column="1" Text="{Binding Percent, StringFormat=p1}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Grid>
                <ListBox ItemsSource="{Binding SelectedListPurposesView}" SelectedItem="{Binding SelectedMyPurpose}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="WhiteSmoke" BorderBrush="SandyBrown" BorderThickness="2"
                                    HorizontalAlignment="Stretch" Margin="5">
                                <Grid>
                                    <StackPanel Orientation="Vertical" Margin="10">
                                        <TextBlock Text="{Binding Purpose, StringFormat='Цель: {0}'}"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Выполнено: "/>
                                            <CheckBox IsChecked="{Binding IsCompleted}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Note, StringFormat='Примечание: {0}'}"/>
                                    </StackPanel> 
                                    <Button Content="X" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            BorderThickness="0" Background="Transparent" FontWeight="Bold"
                                            Padding="5"
                                            Command="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=DataContext.DeletePurposeCommand}"
                                            CommandParameter="{Binding}">
                                        <Button.Resources>
                                            <Style TargetType="Button">
                                                <Setter Property="Foreground" Value="Red"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter Property="Foreground" Value="Green"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </GroupBox>
    </DockPanel>
</UserControl>
