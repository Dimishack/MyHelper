<Window x:Class="MyHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fa="http://schemas.fontawesome.com/icons/"
        xmlns:local="clr-namespace:MyHelper"
        
        xmlns:tasks="clr-namespace:MyHelper.Models.MyTasks"
        xmlns:purposes="clr-namespace:MyHelper.Models.Purposes"
        xmlns:challenges="clr-namespace:MyHelper.Models.Challenges"
        xmlns:uc="clr-namespace:MyHelper.Views.UserControls"
        xmlns:vm="clr-namespace:MyHelper.ViewModels"
        
        mc:Ignorable="d"
        Title="MyHelper"
        Height="450" Width="800"
        WindowStartupLocation="CenterScreen"
        x:Name="ThisWindow">
    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>
    <DockPanel>
        <TabControl>
            <TabItem Header="Цели">
                <uc:ListPurposesUserControl DataContext="{Binding ListPurposes}"/>
            </TabItem>
            <TabItem Header="Задачи">
                <DockPanel>
                    <Grid DockPanel.Dock="Bottom">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding MyTasks.Count, StringFormat='Всего: {0}'}" Margin="3" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Сохранить" Command="{Binding SaveCollectionCommand}" CommandParameter="{Binding MyTasks}"
                                Margin="3" Padding="5"/>
                    </Grid>
                    <Grid>
                        <DataGrid ItemsSource="{Binding MyTasks}" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Задачи" Binding="{Binding Task}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridCheckBoxColumn Header="Важность" Binding="{Binding Prompt}" MinWidth="65" MaxWidth="65"/>
                                <DataGridCheckBoxColumn Header="Срочность" Binding="{Binding Important}" MinWidth="70" MaxWidth="70"/>
                                <DataGridTemplateColumn Header="Срок" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="tasks:MyTasks">
                                            <TextBlock Text="{Binding Term, StringFormat='yyyy.MM.dd'}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate DataType="tasks:MyTasks">
                                            <DatePicker SelectedDate="{Binding Term}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Примечание" Binding="{Binding Note}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Книги" Height="20" VerticalAlignment="Top">
                <DockPanel>
                    <Grid DockPanel.Dock="Bottom" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" FontSize="12">
                            <Label.Content>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Всего: "/>
                                    <TextBlock Text="{Binding MyBooks.Count}"/>
                                </StackPanel>
                            </Label.Content>
                        </Label>
                        <Button Content="Сохранить" Grid.Column="1"
                            Command="{Binding SaveCollectionCommand}" CommandParameter="{Binding MyBooks}"/>
                    </Grid>
                    <DataGrid ItemsSource="{Binding MyBooks}"
                          AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Прочитан" Binding="{Binding IsRead}"
                                                MinWidth="65" MaxWidth="65"/>
                            <DataGridTextColumn Header="Автор" Binding="{Binding Author}"
                                            Width="Auto"/>
                            <DataGridTextColumn Header="Название" Binding="{Binding Title}"
                                            Width="*"/>

                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Челленджи">
                <uc:ListChallengesUserControl DataContext="{Binding Source={StaticResource Locator}, Path=ListChallengesVM}"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
