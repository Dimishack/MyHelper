<Window x:Class="MyHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fa="http://schemas.fontawesome.com/icons/"
        xmlns:local="clr-namespace:MyHelper"
        xmlns:tasks="clr-namespace:MyHelper.Models.MyTasks"
        xmlns:purposes="clr-namespace:MyHelper.Models.Purposes"
        xmlns:challenges="clr-namespace:MyHelper.Models.Challenges"
        xmlns:uc="clr-namespace:MyHelper.Views.UserControls"
        xmlns:vm="clr-namespace:MyHelper.ViewModels"
        mc:Ignorable="d"
        Title="MyHelper"
        Height="450" Width="800"
        WindowStartupLocation="CenterScreen"
        xmlns:uc ="clr-namespace:MyHelper.Views.UserControls"
        x:Name="ThisWindow">
    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>
    <DockPanel>
        <TabControl>
            <TabItem Header="Цели">
                <uc:ListPurposesUserControl DataContext="{Binding ListPurposes}"/>
            </TabItem>
            <TabItem Header="Задачи">
                <DockPanel>
                    <Grid DockPanel.Dock="Bottom">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding MyTasks.Count, StringFormat='Всего: {0}'}" Margin="3" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Сохранить" Command="{Binding SaveCollectionCommand}" CommandParameter="{Binding MyTasks}"
                                Margin="3" Padding="5"/>
                    </Grid>
                    <Grid>
                        <DataGrid ItemsSource="{Binding MyTasks}" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Задачи" Binding="{Binding Task}" Width="Auto"/>
                                <DataGridCheckBoxColumn Header="Важность" Binding="{Binding Prompt}" MinWidth="65" MaxWidth="65"/>
                                <DataGridCheckBoxColumn Header="Срочность" Binding="{Binding Important}" MinWidth="70" MaxWidth="70"/>
                                <DataGridTemplateColumn Header="Срок" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="tasks:MyTasks">
                                            <TextBlock Text="{Binding Term, StringFormat='yyyy.MM.dd'}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate DataType="tasks:MyTasks">
                                            <DatePicker SelectedDate="{Binding Term}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Примечание" Binding="{Binding Note}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Книги" Height="20" VerticalAlignment="Top">
                <DockPanel>
                    <Grid DockPanel.Dock="Bottom" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" FontSize="12">
                            <Label.Content>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Всего: "/>
                                    <TextBlock Text="{Binding MyBooks.Count}"/>
                                </StackPanel>
                            </Label.Content>
                        </Label>
                        <Button Content="Сохранить" Grid.Column="1"
                            Command="{Binding SaveCollectionCommand}" CommandParameter="{Binding MyBooks}"/>
                    </Grid>
                    <DataGrid ItemsSource="{Binding MyBooks}"
                          AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Прочитан" Binding="{Binding IsRead}"
                                                MinWidth="65" MaxWidth="65"/>
                            <DataGridTextColumn Header="Автор" Binding="{Binding Author}"
                                            Width="Auto"/>
                            <DataGridTextColumn Header="Название" Binding="{Binding Title}"
                                            Width="*"/>

                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Челленджи">
                <uc:ListChallengesUserControl DataContext="{Binding Source={StaticResource Locator}, Path=ListChallengesVM}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0">
                        <Button Content="Сохранить" Command="{Binding SaveCollectionCommand}" CommandParameter="{Binding MyChallenges}" DockPanel.Dock="Bottom"
                                Margin="2" Padding="2" />
                        <ListBox ItemsSource="{Binding MyChallenges}" SelectedItem="{Binding SelectedMyChallenges}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="challenges:MyChallenges">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ListName}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition MinHeight="25"/>
                            <RowDefinition MinHeight="25"/>
                        </Grid.RowDefinitions>
                        <GroupBox Grid.Row="0">
                            <GroupBox.Header>
                                <TextBlock Text="{Binding CountChallengesOnProgressing, StringFormat='На выполнении (Всего {0})'}"/>
                            </GroupBox.Header>
                            <DataGrid ItemsSource="{Binding ChallengesOnProgressing}" 
                                      SelectedIndex="{Binding IndexSelectedChallengeOnProgressing, UpdateSourceTrigger=PropertyChanged}"
                                      AutoGenerateColumns="False" CanUserReorderColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Начало" Binding="{Binding DateStartProgressing, StringFormat=yy}"/>
                                    <DataGridTextColumn Header="Челлендж" Binding="{Binding Challenge}" 
                                                        Width="Auto"/>
                                    <DataGridTemplateColumn Header="Чек-лист">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Показать" 
                                                        Command="{Binding ElementName=ThisWindow, Path=DataContext.OpenChecklistChallengeWindowCommand}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Примечание" Binding="{Binding Note}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                        <GroupBox Grid.Row="1">
                            <GroupBox.Header>
                                <TextBlock Text="{Binding CountChallenges, StringFormat='Все (Всего {0})'}"/>
                            </GroupBox.Header>
                            <DataGrid ItemsSource="{Binding SelectedMyChallenges.ListChallenges}" SelectedIndex="{Binding IndexSelectedChallenge}"
                                      AutoGenerateColumns="False" IsReadOnly="False">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="Выполняется" Binding="{Binding IsProgress, UpdateSourceTrigger=PropertyChanged}" 
                                                                MinWidth="85" MaxWidth="85"/>
                                    <DataGridTextColumn Header="Челлендж" Binding="{Binding Challenge}"
                                                        Width="Auto"/>
                                    <DataGridTextColumn Header="Примечание" Binding="{Binding Note}" 
                                                        Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                        <GridSplitter Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="3" Background="Transparent" Panel.ZIndex="10000"/>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
