<Window x:Class="MyHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fa="http://schemas.fontawesome.com/icons/"
        xmlns:local="clr-namespace:MyHelper"
        
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        
        mc:Ignorable="d"
        Title="MyHelper"
        Height="600" Width="1100"
        MinHeight="450"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource MainWindowStyle}"
        DataContext="{Binding Source={StaticResource Locator}, Path=MainWindowVM}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibleConverter"/>
        <Style TargetType="ToolTip" BasedOn="{StaticResource ToolTipMainMenuStyle}">
            <Setter Property="Visibility" Value="{Binding VisibleTooltips, Converter={StaticResource BoolVisibleConverter}}"/>
        </Style>
    </Window.Resources>
    <Grid>
        <DockPanel Width="60" HorizontalAlignment="Left" Panel.ZIndex="2"
                   Background="{StaticResource SolidColorBrush_MossyGreen}">
            <DockPanel.Style>
                <Style TargetType="DockPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowFullMenu}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width"
                                                         To="280"
                                                         Duration="0:0:0.5"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width"
                                                         To="60"
                                                         Duration="0:0:0.3"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DockPanel.Style>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Top"
                         Margin="10,10,0,10" HorizontalAlignment="Left">
                <ToggleButton IsChecked="{Binding ShowFullMenu}"
                              Style="{StaticResource MainMenuStyle}"/>
                <TextBlock Text="M Y  H E L P E R" 
                           VerticalAlignment="Center" FontSize="24"
                           FontFamily="{StaticResource Murs Gothic Key}" 
                           FontWeight="{StaticResource FontWeightBold}"
                           Margin="20,0,0,0"/>
            </StackPanel>
            <Separator DockPanel.Dock="Top" Background="Black"/>
            <ListBox Margin="2,5" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                      SelectionMode="Single" Width="280" BorderThickness="0"
                      Background="Transparent" PreviewMouseLeftButtonDown="ListBox_PreviewMouseLeftButtonDown">
                <ListBoxItem IsSelected="{Binding ShowHomeView}">
                    <ListBoxItem.Style>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource lbItem_menu}">
                            <Setter Property="Image.Source" Value="/Resources/Images/Home.png"/>
                            <Setter Property="TextBlock.Text" Value="H O M E"/>
                        </Style>
                    </ListBoxItem.Style>
                    <ListBoxItem.ToolTip>
                        <ToolTip Content="Home"/>
                    </ListBoxItem.ToolTip>
                </ListBoxItem>
                <ListBoxItem IsSelected="{Binding ShowTargetsView}">
                    <ListBoxItem.Style>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource lbItem_menu}">
                            <Setter Property="Image.Source" Value="/Resources/Images/Targets.png"/>
                            <Setter Property="TextBlock.Text" Value="T A R G E T S"/>
                        </Style>
                    </ListBoxItem.Style>
                    <ListBoxItem.ToolTip>
                        <ToolTip Content="Targets"/>
                    </ListBoxItem.ToolTip>
                </ListBoxItem>
                <ListBoxItem IsSelected="{Binding ShowTasksView}">
                    <ListBoxItem.Style>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource lbItem_menu}">
                            <Setter Property="Image.Source" Value="/Resources/Images/Tasks.png"/>
                            <Setter Property="TextBlock.Text" Value="T A S K S"/>
                        </Style>
                    </ListBoxItem.Style>
                    <ListBoxItem.ToolTip>
                        <ToolTip Content="Tasks"/>
                    </ListBoxItem.ToolTip>
                </ListBoxItem>
                <ListBoxItem IsSelected="{Binding ShowChallengesView}">
                    <ListBoxItem.Style>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource lbItem_menu}">
                            <Setter Property="Image.Source" Value="/Resources/Images/Challenges.png"/>
                            <Setter Property="TextBlock.Text" Value="C H A L L E N G E S"/>
                        </Style>
                    </ListBoxItem.Style>
                    <ListBoxItem.ToolTip>
                        <ToolTip Content="Challenges"/>
                    </ListBoxItem.ToolTip>
                </ListBoxItem>
                <ListBoxItem IsSelected="{Binding ShowBooksView}">
                    <ListBoxItem.Style>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource lbItem_menu}">
                            <Setter Property="Image.Source" Value="/Resources/Images/Books.png"/>
                            <Setter Property="TextBlock.Text" Value="B O O K S"/>
                        </Style>
                    </ListBoxItem.Style>
                    <ListBoxItem.ToolTip>
                        <ToolTip Content="Books"/>
                    </ListBoxItem.ToolTip>
                </ListBoxItem>
                <ListBoxItem IsSelected="{Binding ShowFilmsView}">
                    <ListBoxItem.Style>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource lbItem_menu}">
                            <Setter Property="Image.Source" Value="/Resources/Images/Film.png"/>
                            <Setter Property="TextBlock.Text" Value="F I L M S"/>
                        </Style>
                    </ListBoxItem.Style>
                    <ListBoxItem.ToolTip>
                        <ToolTip Content="Films"/>
                    </ListBoxItem.ToolTip>
                </ListBoxItem>
                <ListBoxItem IsSelected="{Binding ShowSettingsView}">
                    <ListBoxItem.Style>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource lbItem_menu}">
                            <Setter Property="Image.Source" Value="/Resources/Images/Settings.png"/>
                            <Setter Property="TextBlock.Text" Value="S E T T I N G S"/>
                        </Style>
                    </ListBoxItem.Style>
                    <ListBoxItem.ToolTip>
                        <ToolTip Content="Settings"/>
                    </ListBoxItem.ToolTip>
                </ListBoxItem>
            </ListBox>
        </DockPanel>
        <Grid Background="#002800" Opacity="0.6" Panel.ZIndex="1"
              Visibility="{Binding ShowFullMenu, Converter={StaticResource BoolVisibleConverter}}">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="MouseLeftButtonDown">
                    <i:InvokeCommandAction Command="{Binding HideMenuCommand}"/>
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </Grid>
        <Grid Margin="60,0,0,0">
            <Grid.Resources>
                <GradientStopCollection x:Key="SideGradient">
                    <GradientStop Color="{StaticResource Color_MossyGreen}" Offset="0"/>
                    <GradientStop Color="{StaticResource Color_Gold}" Offset="0.025"/>
                </GradientStopCollection>
            </Grid.Resources>
            <Grid.Background>
                <RadialGradientBrush RadiusX="0.8" RadiusY="1">
                    <GradientStop Color="{StaticResource Color_Gold}" Offset="0.74"/>
                    <GradientStop Color="{StaticResource Color_MossyGreen}" Offset="0.8"/>
                </RadialGradientBrush>
            </Grid.Background>
            <Border Margin="0,10">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="0.5,0.5"
                                         GradientStops="{StaticResource SideGradient}"/>
                </Border.Background>
            </Border>
            <Border Margin="10,10,0,10">
                <Border.Background>
                    <LinearGradientBrush StartPoint="1,0.5" EndPoint="0.5,0.5"
                                         GradientStops="{StaticResource SideGradient}"/>
                </Border.Background>
            </Border>
            <Border Margin="10,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1"
                                         GradientStops="{StaticResource SideGradient}"/>
                </Border.Background>
            </Border>
            <Border Margin="10,10,10,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.5,1" EndPoint="0.5,0"
                                         GradientStops="{StaticResource SideGradient}"/>
                </Border.Background>
            </Border>

            <Border Background="{StaticResource SolidColorBrush_Gold}" Margin="10">
                <ContentPresenter Margin="5,3" Content="{Binding CurrentViewModel}"/>
            </Border>
        </Grid>
    </Grid>
</Window>
