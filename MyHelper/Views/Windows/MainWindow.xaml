<Window x:Class="MyHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fa="http://schemas.fontawesome.com/icons/"
        xmlns:local="clr-namespace:MyHelper"
        xmlns:tasks="clr-namespace:MyHelper.Models.MyTasks"
        xmlns:purposes="clr-namespace:MyHelper.Models.Purposes"
        xmlns:challenges="clr-namespace:MyHelper.Models.Challenges"
        mc:Ignorable="d"
        DataContext="{Binding MainWindowViewModel, Source={StaticResource Locator}}"
        Title="MyHelper"
        Height="450" Width="800"
        WindowStartupLocation="CenterScreen"
        xmlns:uc ="clr-namespace:MyHelper.Views.UserControls"
        x:Name="ThisWindow">
    <DockPanel>
        <Menu DockPanel.Dock="Top">

        </Menu>
        <StatusBar DockPanel.Dock="Bottom">

        </StatusBar>
        <TabControl>
            <TabItem Header="Цели">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <GroupBox Grid.Column="0" Header="Года">
                        <DockPanel>
                            <UniformGrid DockPanel.Dock="Bottom" Rows="2">
                                <Button Content="Добавить год" Command="{Binding CreateNewListPurposesCommand}"/>
                                <Button Content="Сохранить" Command="{Binding SaveCollectionCommand}" CommandParameter="{Binding MyPurposes}"/>
                            </UniformGrid>
                            <ListBox x:Name="Testing" ItemsSource="{Binding MyPurposes}" SelectedItem="{Binding SelectedMyPurposes}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="purposes:MyPurposes">
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </GroupBox>
                    <GroupBox Grid.Column="1" Header="Выбранный год">
                        <DockPanel>
                            <Grid DockPanel.Dock="Bottom">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=Testing, Path=SelectedIndex}" Value="-1">
                                                <Setter Property="Visibility" Value="Hidden"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Label FontSize="12" Grid.Column="0">
                                    <Label.Content>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding CompletedPurposes, StringFormat='Выполненных/Всего: {0}/', UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Text="{Binding ListPurposesCount, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Label.Content>
                                </Label>
                                <ProgressBar Grid.Column="1" Maximum="{Binding ListPurposesCount}" 
                                             Value="{Binding CompletedPurposes}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Procent}" FontWeight="Bold" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <DataGrid ItemsSource="{Binding SelectedMyPurposes.ListPurposes}" 
                                  AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="Выполнен" 
                                                        MinWidth="65" MaxWidth="65" 
                                                        Binding="{Binding IsCompleted, UpdateSourceTrigger=PropertyChanged}"/>
                                    <DataGridTextColumn Header="Цель" Width="*" 
                                                    Binding="{Binding Purpose}" ElementStyle="{StaticResource TextWrap}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </GroupBox>
                </Grid>
            </TabItem>
            <TabItem Header="Задачи">
                <DockPanel>
                    <Grid DockPanel.Dock="Bottom">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding MyTasks.Count, StringFormat='Всего: {0}'}" Margin="3" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Сохранить" Command="{Binding SaveCollectionCommand}" CommandParameter="{Binding MyTasks}"
                                Margin="3" Padding="5"/>
                    </Grid>
                    <Grid>
                        <DataGrid ItemsSource="{Binding MyTasks}" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Задачи" Binding="{Binding Task}" Width="Auto"
                                                    ElementStyle="{StaticResource TextWrap}"/>
                                <DataGridCheckBoxColumn Header="Важность" Binding="{Binding Prompt}" MinWidth="65" MaxWidth="65"/>
                                <DataGridCheckBoxColumn Header="Срочность" Binding="{Binding Important}" MinWidth="70" MaxWidth="70"/>
                                <DataGridTemplateColumn Header="Срок" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="tasks:MyTasks">
                                            <TextBlock Text="{Binding Term, StringFormat='yyyy.MM.dd'}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate DataType="tasks:MyTasks">
                                            <DatePicker SelectedDate="{Binding Term}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Примечание" Binding="{Binding Note}" Width="*"
                                                    ElementStyle="{StaticResource TextWrap}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Книги" Height="20" VerticalAlignment="Top">
                <DockPanel>
                    <Grid DockPanel.Dock="Bottom" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" FontSize="12">
                            <Label.Content>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Всего: "/>
                                    <TextBlock Text="{Binding MyBooks.Count}"/>
                                </StackPanel>
                            </Label.Content>
                        </Label>
                        <Button Content="Сохранить" Grid.Column="1"
                            Command="{Binding SaveCollectionCommand}" CommandParameter="{Binding MyBooks}"/>
                    </Grid>
                    <DataGrid ItemsSource="{Binding MyBooks}"
                          AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Прочитан" Binding="{Binding IsRead}"
                                                MinWidth="65" MaxWidth="65"/>
                            <DataGridTextColumn Header="Автор" Binding="{Binding Author}"
                                            Width="Auto"
                                                ElementStyle="{StaticResource TextWrap}"/>
                            <DataGridTextColumn Header="Название" Binding="{Binding Title}"
                                            Width="*"
                                                ElementStyle="{StaticResource TextWrap}"/>

                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Челленджи">
                <uc:ListChallengesUserControl DataContext="{Binding Source={StaticResource Locator}, Path=ListChallengesVM}"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
