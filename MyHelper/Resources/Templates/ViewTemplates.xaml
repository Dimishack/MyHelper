<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:MyHelper.ViewModels"
                    xmlns:uc="clr-namespace:MyHelper.Views.UserControls">
    <DataTemplate DataType="{x:Type vm:HomeViewModel}">
        <uc:HomeUserControl DataContext="{Binding}"/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:TargetsUCViewModel}">
        <uc:TargetsUserControl DataContext="{Binding}"/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:TasksUCViewModel}">
        <uc:TasksUserControl DataContext="{Binding}"/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ChallengesUCViewModel}">
        <uc:ChallengesUserControl DataContext="{Binding}"/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:BooksUCViewModel}">
        <uc:BooksUserControl DataContext="{Binding}"/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:MovieUCViewModel}">
        <uc:MovieUserControl DataContext="{Binding}"/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsUCViewModel}">
        <uc:SettingsUserControl DataContext="{Binding}"/>
    </DataTemplate>
</ResourceDictionary>