<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:MyHelper.ViewModels"
                    xmlns:uc="clr-namespace:MyHelper.Views.UserControls">
    <DataTemplate DataType="{x:Type vm:TargetsUCViewModel}">
        <uc:TargetsUserControl DataContext="{Binding}"/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ListTasksUCViewModel}">
        <uc:ListTasksUserControl DataContext="{Binding}"/>
    </DataTemplate>
</ResourceDictionary>