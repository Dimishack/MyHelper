<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp">
    <Style TargetType="Button" x:Key="ForDeleteInListBoxes">
        <Setter Property="Content" Value="X"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightBold}"/>
        <Setter Property="Padding" Value="5,0"/>
        <Setter Property="CommandParameter" Value="{Binding}"/>
        <Setter Property="Foreground" Value="Red"/>
        <Style.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Foreground" Value="Green"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Button" x:Key="ForPanels">
        <Setter Property="Margin" Value="3,5"/>
    </Style>
    <Style TargetType="TextBlock" x:Key="ForPanelsInButton">
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="Margin" Value="5"/>
    </Style>

    <Style TargetType="Button" x:Key="ForUGInCreator_Editors">
        <Setter Property="Margin" Value="10,5"/>
        <Setter Property="Padding" Value="35,10"/>
        <Style.Triggers>
            <Trigger Property="IsDefault" Value="True">
                <Setter Property="Content" Value="OK"/>
                <Setter Property="FontWeight" Value="{StaticResource FontWeightBold}"/>
            </Trigger>
            <Trigger Property="IsCancel" Value="True">
                <Setter Property="Content" Value="Cancel"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Button" x:Key="ButtonMainStyle">
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Padding" Value="3"/>
        <Setter Property="Background" Value="{StaticResource SolidColorBrush_BrightOrange}"/>
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush_Mustard}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}"
                            Margin="{TemplateBinding Margin}" Padding="{TemplateBinding Padding}"
                            IsEnabled="{TemplateBinding IsEnabled}" CornerRadius="{StaticResource CornerRadius5}">
                        <fa:IconImage x:Name="icon" Icon="{TemplateBinding fa:IconImage.Icon}"
                                      Foreground="{TemplateBinding Foreground}" Width="16"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background"
                                    Value="{StaticResource SolidColorBrush_MangoTango}"/>
                <Setter Property="Foreground"
                                    Value="{StaticResource SolidColorBrush_Vanilla}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background"
                                    Value="{StaticResource SolidColorBrush_GoldenTainoi}"/>
                <Setter Property="Foreground"
                                    Value="{StaticResource SolidColorBrush_BrightOrange}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background"
                                    Value="{StaticResource SolidColorBrush_BrightOrange}"/>
                <Setter Property="Foreground"
                                    Value="{StaticResource SolidColorBrush_Vanilla}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Button" x:Key="DeleteElementStyle"
           BasedOn="{StaticResource ButtonMainStyle}">
        <Setter Property="fa:IconImage.Icon" Value="Xmark"/>
    </Style>


    <Style TargetType="Button" x:Key="CheckOrCancelElementStyle"
           BasedOn="{StaticResource ButtonMainStyle}">
        <Setter Property="Margin" Value="10,5"/>
        <Setter Property="Padding" Value="35,10"/>
        <Setter Property="Background" Value="{StaticResource SolidColorBrush_WalnutBrown}"/>
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush_Sandy}"/>
        <Style.Triggers>
            <Trigger Property="IsDefault" Value="True">
                <Setter Property="fa:IconImage.Icon" Value="Check"/>
                <Setter Property="FontWeight" Value="{StaticResource FontWeightBold}"/>
            </Trigger>
            <Trigger Property="IsCancel" Value="True">
                <Setter Property="fa:IconImage.Icon" Value="Cancel"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background"
                        Value="{StaticResource SolidColorBrush_LightBrownishGray}"/>
                <Setter Property="Foreground"
                        Value="{StaticResource SolidColorBrush_LightSandy}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background"
                        Value="{StaticResource SolidColorBrush_LightSandy}"/>
                <Setter Property="Foreground"
                        Value="{StaticResource SolidColorBrush_LightBrownishGray}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background"
                        Value="{StaticResource SolidColorBrush_PearlBeige}"/>
                <Setter Property="Foreground"
                        Value="{StaticResource SolidColorBrush_LightSandy}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Button" x:Key="ButtonSaveStyle" BasedOn="{StaticResource ButtonMainStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" 
                            Margin="{TemplateBinding Margin}" Padding="{TemplateBinding Padding}"
                            IsEnabled="{TemplateBinding IsEnabled}" CornerRadius="{StaticResource CornerRadius5}">
                        <Grid>
                            <fa:IconImage x:Name="icon" Icon="Save" IconFont="Regular" Width="16" Foreground="{TemplateBinding Foreground}"/>
                            <TextBlock x:Name="text" Text="Автосохр." HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Hidden"
                                       FontSize="{TemplateBinding FontSize}"
                                       Style="{StaticResource TextBlockMainStyle}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Visibility"
                                    TargetName="icon"
                                    Value="Hidden"/>
                            <Setter Property="Visibility"
                                    TargetName="text"
                                    Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>