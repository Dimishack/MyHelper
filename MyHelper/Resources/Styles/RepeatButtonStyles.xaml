<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="ScrollBar_Track" TargetType="{x:Type RepeatButton}">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{StaticResource SolidColorBrush_Transparent}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBar_UpArrow" TargetType="RepeatButton">
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush_BrightOrange}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border x:Name="border" CornerRadius="10" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="0"
                        SnapsToDevicePixels="True">
                        <Path x:Name="arrow" Data="{StaticResource ArrowUp_ScrollBar}" 
                              Fill="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground"
                        Value="{StaticResource SolidColorBrush_MangoTango}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground"
                        Value="{StaticResource SolidColorBrush_GoldenTainoi}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ScrollBar_UpArrow_AdditionalUserControl" TargetType="RepeatButton"
           BasedOn="{StaticResource ScrollBar_UpArrow}">
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush_WalnutBrown}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource SolidColorBrush_BeigeBrown}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource SolidColorBrush_DarkSandy}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ScrollBar_DownArrow" TargetType="RepeatButton">
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush_BrightOrange}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border x:Name="border" CornerRadius="10" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="0"
                        SnapsToDevicePixels="True">
                        <Path x:Name="arrow" Data="{StaticResource ArrowDown_ScrollBar}" 
                              Fill="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground"
                        Value="{StaticResource SolidColorBrush_MangoTango}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground"
                        Value="{StaticResource SolidColorBrush_GoldenTainoi}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ScrollBar_DownArrow_AdditionalUserControl" TargetType="RepeatButton"
           BasedOn="{StaticResource ScrollBar_DownArrow}">
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush_WalnutBrown}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource SolidColorBrush_BeigeBrown}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource SolidColorBrush_DarkSandy}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>