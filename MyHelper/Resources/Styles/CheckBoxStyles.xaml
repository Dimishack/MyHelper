<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="CheckBox">
        <Setter Property="IsChecked" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="border" CornerRadius="1" 
                            BorderBrush="{StaticResource SolidColorBrush_YellowBroom}" BorderThickness="2" 
                            Background="{StaticResource SolidColorBrush_Cream}"
                            HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Grid>
                            <Path x:Name="Dot" Stroke="{StaticResource SolidColorBrush_YellowBroom}" Margin="1" StrokeThickness="2"
                                  Data="{StaticResource XMark_CheckBox}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush"
                                    TargetName="border"
                                    Value="{StaticResource SolidColorBrush_YellowCurry}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Data"
                                    TargetName="Dot"
                                    Value="{StaticResource Check_CheckBox}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter Property="Visibility"
                                    TargetName="Dot"
                                    Value="Hidden"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>