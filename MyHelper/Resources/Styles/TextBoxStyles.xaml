<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="TextBox" x:Key="TextBoxMainStyle">
        <Setter Property="SelectionBrush" Value="{StaticResource SolidColorBrush_LightBrownishGray}"/>
        <Setter Property="CaretBrush" Value="{StaticResource SolidColorBrush_DarkGreenishYellowGreen}"/>
        <Setter Property="IsReadOnlyCaretVisible" Value="True"/>
        <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst"/>
        <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush_DarkGreenishYellowGreen}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Effect" Value="{StaticResource WalnutBrownFogEffect}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border" Background="{StaticResource SolidColorBrush_LightSandy}" 
                            BorderBrush="{StaticResource SolidColorBrush_DarkSandy}" 
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Margin="{TemplateBinding Margin}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="{StaticResource CornerRadius5}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" 
                                      VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                                  Margin="3,2"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush"
                                    TargetName="border"
                                    Value="{StaticResource SolidColorBrush_LightBrownishGray}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="BorderBrush"
                                    TargetName="border"
                                    Value="{StaticResource SolidColorBrush_PearlBeige}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox" x:Key="TextBoxForAdd_EditStyle" BasedOn="{StaticResource TextBoxMainStyle}">
        <Setter Property="Margin" Value="3"/>
    </Style>

    <Style TargetType="TextBox" x:Key="TextBox_DatePickerTextBox" BasedOn="{StaticResource TextBoxMainStyle}">
        <Setter Property="Effect" Value="{x:Null}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
</ResourceDictionary>