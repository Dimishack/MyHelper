<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="TextBox" x:Key="TextBoxMainStyle">
        <Setter Property="SelectionBrush" Value="#8b6d5c"/>
        <Setter Property="CaretBrush" Value="{StaticResource SolidColorBrush_DarkGreenishYellowGreen}"/>
        <Setter Property="IsReadOnlyCaretVisible" Value="True"/>
        <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst"/>
        <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush_DarkGreenishYellowGreen}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border" Background="{StaticResource SolidColorBrush_LightSandy}" 
                            BorderBrush="{StaticResource SolidColorBrush_DarkSandy}" BorderThickness="2"
                            CornerRadius="5" Margin="{TemplateBinding Margin}"
                        Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect Color="{StaticResource Color_WalnutBrown}" BlurRadius="25"
                                              ShadowDepth="0.5" Opacity="0.8"/>
                        </Border.Effect>

                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" 
                                      VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                                  Margin="3,2"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush"
                                TargetName="border"
                                Value="{StaticResource SolidColorBrush_LightBrownishGray}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="BorderBrush"
                                TargetName="border"
                                Value="{StaticResource SolidColorBrush_PearlBeige}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>