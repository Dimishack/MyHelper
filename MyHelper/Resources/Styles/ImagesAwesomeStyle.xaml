<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:fa5="http://schemas.fontawesome.com/icons/"
                    xmlns:ice="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    mc:Ignorable="ice">
    <Style TargetType="fa5:ImageAwesome" x:Key="AddImage" ice:Freeze="True">
        <Setter Property="Icon" Value="Solid_Plus"/>
        <Setter Property="Width" Value="16"/>
    </Style>
    <Style TargetType="fa5:ImageAwesome" x:Key="RemoveImage" ice:Freeze="True">
        <Setter Property="Icon" Value="Solid_Minus"/>
        <Setter Property="Width" Value="16"/>
    </Style>
    <Style TargetType="fa5:ImageAwesome" x:Key="EditImage" ice:Freeze="True">
        <Setter Property="Icon" Value="Regular_Edit"/>
        <Setter Property="Width" Value="16"/>
    </Style>
    <Style TargetType="fa5:ImageAwesome" x:Key="SaveImage" ice:Freeze="True">
        <Setter Property="Icon" Value="Regular_Save"/>
        <Setter Property="Width" Value="16"/>
    </Style>

</ResourceDictionary>