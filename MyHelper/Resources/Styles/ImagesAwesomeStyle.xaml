<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:fa5="http://schemas.fontawesome.com/icons/"
                    xmlns:ice="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
                    mc:Ignorable="ice">
    <Style TargetType="fa:IconImage" x:Key="AddFAStyle" ice:Freeze="True">
        <Setter Property="Icon" Value="Plus"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="IconFont" Value="Solid"/>
    </Style>
    <Style TargetType="fa:IconImage" x:Key="RemoveFAStyle" ice:Freeze="True">
        <Setter Property="Icon" Value="Xmark"/>
        <Setter Property="Width" Value="16"/>
    </Style>
    <Style TargetType="fa:IconImage" x:Key="EditFAStyle" ice:Freeze="True">
        <Setter Property="Icon" Value="Edit"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="IconFont" Value="Solid"/>
    </Style>
    <Style TargetType="fa:IconImage" x:Key="SaveFAStyle" ice:Freeze="True">
        <Setter Property="Icon" Value="Save"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="IconFont" Value="Regular"/>
    </Style>

</ResourceDictionary>