<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp">
    <Style TargetType="ToggleButton" x:Key="MainMenuStyle">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="border" Width="{TemplateBinding Width}"
                            Height="{TemplateBinding Height}">
                        <Border.Background>
                            <ImageBrush ImageSource="/Resources/Images/Menu.png"
                                        Stretch="Fill"/>
                        </Border.Background>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background"
                                    TargetName="border">
                                <Setter.Value>
                                    <ImageBrush ImageSource="/Resources/Images/Menu_MouseOver.png"
                                        Stretch="Fill"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Background"
                                    TargetName="border">
                                <Setter.Value>
                                    <ImageBrush ImageSource="/Resources/Images/Menu_MouseOver.png"
                                        Stretch="Fill"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToggleButton" x:Key="ComboBoxToggleButton">
        <Setter Property="ClickMode" Value="Press"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="border" Background="{StaticResource SolidColorBrush_BrightOrange}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Path x:Name="arrow" Data="{StaticResource Arrow_ComboBox}" 
                          Fill="{StaticResource SolidColorBrush_Mustard}" 
                          HorizontalAlignment="Right" VerticalAlignment="Center"
                          Margin="0,0,7,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Fill"
                                TargetName="arrow"
                                Value="{StaticResource SolidColorBrush_Vanilla}"/>
                            <Setter Property="Effect"
                                TargetName="arrow">
                                <Setter.Value>
                                    <DropShadowEffect Color="{StaticResource Color_Mustard}" ShadowDepth="0.9"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Fill"
                                TargetName="arrow"
                                Value="{StaticResource SolidColorBrush_Vanilla}"/>
                            <Setter Property="Effect"
                                TargetName="arrow">
                                <Setter.Value>
                                    <DropShadowEffect Color="{StaticResource Color_Mustard}" ShadowDepth="0.9"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToggleButton" x:Key="ToggleButtonMainStyle">
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Padding" Value="3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="border" Background="{StaticResource SolidColorBrush_BrightOrange}" Margin="{TemplateBinding Margin}"
                            Padding="{TemplateBinding Padding}"
                            IsEnabled="{TemplateBinding IsEnabled}">
                        <fa:IconImage x:Name="icon" Foreground="{StaticResource SolidColorBrush_Mustard}"
                                  Icon="{TemplateBinding fa:IconImage.Icon}" Width="16"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background"
                                    TargetName="border"
                                    Value="{StaticResource SolidColorBrush_MangoTango}"/>
                            <Setter Property="Foreground"
                                    TargetName="icon"
                                    Value="{StaticResource SolidColorBrush_Vanilla}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background"
                                    TargetName="border"
                                    Value="{StaticResource SolidColorBrush_GoldenTainoi}"/>
                            <Setter Property="Foreground"
                                    TargetName="icon"
                                    Value="{StaticResource SolidColorBrush_BrightOrange}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background"
                                    TargetName="border"
                                    Value="{StaticResource SolidColorBrush_BrightOrange}"/>
                            <Setter Property="Foreground"
                                    TargetName="icon"
                                    Value="{StaticResource SolidColorBrush_Vanilla}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="IsEnabled" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Background"
                                    TargetName="border"
                                    Value="{StaticResource SolidColorBrush_BrightOrange}"/>
                            <Setter Property="Foreground"
                                    TargetName="icon"
                                    Value="{StaticResource SolidColorBrush_Vanilla}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonMainStyle}" x:Key="AddElementStyle">
        <Setter Property="fa:IconImage.Icon" Value="Plus"/>
    </Style>
    <Style TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonMainStyle}" x:Key="EditElementStyle">
        <Setter Property="fa:IconImage.Icon" Value="Edit"/>
    </Style>

</ResourceDictionary>