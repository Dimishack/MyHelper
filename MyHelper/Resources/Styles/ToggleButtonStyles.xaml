<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp">
    <Style TargetType="ToggleButton" x:Key="ToggleButtonMainStyle">
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Padding" Value="3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="border" Background="{StaticResource SolidColorBrush_BrightOrange}" Margin="{TemplateBinding Margin}"
                            Padding="{TemplateBinding Padding}"
                            IsEnabled="{TemplateBinding IsEnabled}"
                            CornerRadius="{StaticResource CornerRadius5}">
                        <fa:IconImage x:Name="icon" Foreground="{StaticResource SolidColorBrush_Mustard}"
                                  Icon="{TemplateBinding fa:IconImage.Icon}" Width="16"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background"
                                    TargetName="border"
                                    Value="{StaticResource SolidColorBrush_MangoTango}"/>
                            <Setter Property="Foreground"
                                    TargetName="icon"
                                    Value="{StaticResource SolidColorBrush_Vanilla}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background"
                                    TargetName="border"
                                    Value="{StaticResource SolidColorBrush_GoldenTainoi}"/>
                            <Setter Property="Foreground"
                                    TargetName="icon"
                                    Value="{StaticResource SolidColorBrush_BrightOrange}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background"
                                    TargetName="border"
                                    Value="{StaticResource SolidColorBrush_BrightOrange}"/>
                            <Setter Property="Foreground"
                                    TargetName="icon"
                                    Value="{StaticResource SolidColorBrush_Vanilla}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="IsEnabled" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Background"
                                    TargetName="border"
                                    Value="{StaticResource SolidColorBrush_BrightOrange}"/>
                            <Setter Property="Foreground"
                                    TargetName="icon"
                                    Value="{StaticResource SolidColorBrush_Vanilla}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style TargetType="ToggleButton" x:Key="MainMenuStyle">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="border" Width="{TemplateBinding Width}"
                            Height="{TemplateBinding Height}"
                            CornerRadius="{StaticResource CornerRadius5}">
                        <Border.Background>
                            <ImageBrush ImageSource="/Resources/Images/Menu.png"
                                        Stretch="Fill"/>
                        </Border.Background>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background"
                                    TargetName="border">
                                <Setter.Value>
                                    <ImageBrush ImageSource="/Resources/Images/Menu_MouseOver.png"
                                        Stretch="Fill"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Background"
                                    TargetName="border">
                                <Setter.Value>
                                    <ImageBrush ImageSource="/Resources/Images/Menu_MouseOver.png"
                                        Stretch="Fill"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToggleButton" x:Key="ToggleButtonForComboBoxStyle">
        <Setter Property="ClickMode" Value="Press"/>
        <Setter Property="Background" Value="{StaticResource SolidColorBrush_Mandarin}"/>
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush_Mustard}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}" 
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            CornerRadius="{StaticResource CornerRadius5}">
                        <Path x:Name="arrow" Data="{StaticResource Arrow_ComboBox}" 
                              Fill="{TemplateBinding Foreground}" 
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Margin="0,0,7,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground"
                                    Value="{StaticResource SolidColorBrush_Vanilla}"/>
                            <Setter Property="Effect"
                                    TargetName="arrow"
                                    Value="{StaticResource VanillaFogEffect}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground"
                                    Value="{StaticResource SolidColorBrush_Vanilla}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToggleButton" x:Key="ToggleButtonForComboBox_Add_EditUserControlStyle" 
           BasedOn="{StaticResource ToggleButtonForComboBoxStyle}">
        <Setter Property="Background" Value="{StaticResource SolidColorBrush_StrongBronzeShade}"/>
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush_Sandy}"/>
    </Style>

    <Style TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonMainStyle}" x:Key="AddElementStyle">
        <Setter Property="fa:IconImage.Icon" Value="Plus"/>
    </Style>
    <Style TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonMainStyle}" x:Key="EditElementStyle">
        <Setter Property="fa:IconImage.Icon" Value="Edit"/>
    </Style>

</ResourceDictionary>