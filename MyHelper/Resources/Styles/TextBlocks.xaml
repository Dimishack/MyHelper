<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="TextBlock" x:Key="TextBlockMainStyle">
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush_DarkGreenishYellowGreen}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    
    <Style TargetType="TextBlock" x:Key="TextBlockForAdd_EditUC" BasedOn="{StaticResource TextBlockMainStyle}">
        <Style.Triggers>
            <Trigger Property="Grid.Column" Value="0">
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="FontWeight" Value="{StaticResource FontWeightMedium}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="3,0"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="TextBlock" x:Key="TextBlockInListBoxStyle" BasedOn="{StaticResource TextBlockMainStyle}">
        <Setter Property="Margin" Value="3,2"/>
    </Style>
    
</ResourceDictionary>