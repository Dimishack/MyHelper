<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type ToolTip}" x:Key="ToolTipMainMenuStyle">
        <Setter Property="Placement" Value="Right"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Width" Value="100"/>
        <Setter Property="Background" Value="{StaticResource SolidColorBrush_AlmostApple}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush_Transparent}"/>
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush_Cream}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontFamily" Value="{StaticResource Ruthless Sketch}"/>
        <Setter Property="PlacementRectangle" Value="45,0,0,0"/>
        <Setter Property="HorizontalOffset" Value="25"/>
        <Setter Property="VerticalOffset" Value="6"/>
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="FontWeight" Value="{StaticResource FontWeightBold}"/>
    </Style>
</ResourceDictionary>