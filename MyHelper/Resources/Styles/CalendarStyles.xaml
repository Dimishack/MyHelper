<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="CalendarButton" x:Key="CalendarButtonMainStyle">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarButton">
                    <Grid>
                        <Border x:Name="border" Background="{StaticResource SolidColorBrush_Transparent}"
                            BorderBrush="{StaticResource SolidColorBrush_Transparent}" BorderThickness="2"
                            CornerRadius="{StaticResource CornerRadius3}"/>
                        <ContentPresenter x:Name="NormalText" Margin="2"
                                      TextElement.Foreground="{StaticResource SolidColorBrush_DarkGreenishYellowGreen}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      TextElement.FontSize="12"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background"
                                TargetName="border"
                                Value="{StaticResource SolidColorBrush_LightBrownishGray}"/>
                            <Setter Property="TextElement.Foreground"
                                TargetName="NormalText"
                                Value="#fdf4e3"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="Background" TargetName="border"
                                    Value="{StaticResource SolidColorBrush_LightBrownishGray}"/>
                            <Setter Property="TextElement.Foreground"
                                    TargetName="NormalText"
                                    Value="{StaticResource SolidColorBrush_Cream}"/>
                            <Setter Property="BorderBrush"
                                TargetName="border"
                                Value="{StaticResource SolidColorBrush_WalnutBrown}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CalendarDayButton" x:Key="CalendarDayButtonMainStyle">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarDayButton">
                    <Grid>
                        <Border x:Name="border" Background="{StaticResource SolidColorBrush_Transparent}"
                            BorderBrush="{StaticResource SolidColorBrush_Transparent}" BorderThickness="1.2"
                            CornerRadius="{StaticResource CornerRadius3}"/>
                        <ContentPresenter x:Name="NormalText" Margin="5,0.3"
                                      TextElement.Foreground="{StaticResource SolidColorBrush_DarkGreenishYellowGreen}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      TextElement.FontSize="11"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsToday" Value="True">
                            <Setter Property="Background"
                                    TargetName="border"
                                    Value="{StaticResource SolidColorBrush_PearlBeige}"/>
                            <Setter Property="TextElement.Foreground"
                                    TargetName="NormalText"
                                    Value="{StaticResource SolidColorBrush_Cream}"/>
                        </Trigger>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="TextElement.Foreground"
                                    TargetName="NormalText" 
                                    Value="{StaticResource SolidColorBrush_ProtectiveKhaki}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" TargetName="border"
                                Value="{StaticResource SolidColorBrush_LightBrownishGray}"/>
                            <Setter Property="TextElement.Foreground"
                                TargetName="NormalText"
                                Value="{StaticResource SolidColorBrush_Cream}"/>
                            <Setter Property="BorderBrush"
                                TargetName="border"
                                Value="{StaticResource SolidColorBrush_WalnutBrown}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background"
                                TargetName="border"
                                Value="{StaticResource SolidColorBrush_LightBrownishGray}"/>
                            <Setter Property="TextElement.Foreground"
                                TargetName="NormalText"
                                Value="{StaticResource SolidColorBrush_Cream}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsInactive" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Background"
                                TargetName="border"
                                Value="{StaticResource SolidColorBrush_LightBrownishGray}"/>
                            <Setter Property="TextElement.Foreground"
                                TargetName="NormalText"
                                Value="{StaticResource SolidColorBrush_LightSandy}"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsInactive" Value="True"/>
                                <Condition Property="IsSelected" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" 
                                    TargetName="border"
                                Value="{StaticResource SolidColorBrush_LightBrownishGray}"/>
                            <Setter Property="TextElement.Foreground"
                                TargetName="NormalText"
                                Value="{StaticResource SolidColorBrush_LightSandy}"/>
                            <Setter Property="BorderBrush"
                                TargetName="border"
                                Value="{StaticResource SolidColorBrush_WalnutBrown}"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsInactive" Value="True"/>
                                <Condition Property="IsToday" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Background"
                                TargetName="border"
                                Value="{StaticResource SolidColorBrush_LightBrownishGray}"/>
                            <Setter Property="TextElement.Foreground"
                                TargetName="NormalText"
                                Value="{StaticResource SolidColorBrush_Cream}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="CalendarItem" x:Key="MyCalendarItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarItem">
                    <ControlTemplate.Resources>
                        <DataTemplate x:Key="{x:Static CalendarItem.DayTitleTemplateResourceKey}">
                            <TextBlock Foreground="{StaticResource SolidColorBrush_DarkGreenishYellowGreen}"
                                       FontWeight="{StaticResource FontWeightBold}" FontSize="10" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="0,6,0,6" Text="{Binding}"/>
                        </DataTemplate>
                    </ControlTemplate.Resources>
                    <Grid x:Name="PART_Root">
                        <Border Background="{StaticResource SolidColorBrush_LightSandy}" Padding="5,0"
                                BorderBrush="{StaticResource SolidColorBrush_DarkSandy}" BorderThickness="2,4,2,3" 
                                CornerRadius="{StaticResource CornerRadius3}">
                            <Border.Resources>
                                <ControlTemplate TargetType="Button" x:Key="LeftButton">
                                    <Border x:Name="border" Background="Transparent" Margin="0,10"
                                        CornerRadius="4">
                                        <Path x:Name="arrow" Data="{StaticResource ArrowLeft_Calendar}" 
                                              Fill="{StaticResource SolidColorBrush_WalnutBrown}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="7"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background"
                                                TargetName="border"
                                                Value="{StaticResource SolidColorBrush_DarkSandy}"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Fill"
                                                TargetName="arrow"
                                                Value="{StaticResource SolidColorBrush_LightSandy}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                                <ControlTemplate TargetType="Button" x:Key="RightButton">
                                    <Border x:Name="border" Background="{StaticResource SolidColorBrush_Transparent}" Margin="0,10"
                                        CornerRadius="4">
                                        <Path x:Name="arrow" 
                                              Data="{StaticResource ArrowRight_Calendar}" 
                                              Fill="{StaticResource SolidColorBrush_WalnutBrown}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="7"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background"
                                                TargetName="border"
                                                Value="{StaticResource SolidColorBrush_LightBrownishGray}"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Fill"
                                                TargetName="arrow"
                                                Value="{StaticResource SolidColorBrush_LightSandy}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                                <ControlTemplate TargetType="Button" x:Key="HeaderButton">
                                    <Border x:Name="border" Background="{StaticResource SolidColorBrush_Transparent}"
                                            Padding="0,3,0,4"
                                            Margin="-5,-1,-5,0"
                                            BorderBrush="{StaticResource SolidColorBrush_DarkSandy}" BorderThickness="0,0,0,2.5" 
                                            CornerRadius="0,0,6,6">
                                        <ContentPresenter x:Name="content" 
                                                          ContentSource="Content" ContentTemplate="{TemplateBinding ContentTemplate}" 
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          TextElement.Foreground="{StaticResource SolidColorBrush_DarkGreenishYellowGreen}" 
                                                          TextElement.FontSize="14"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background"
                                                TargetName="border"
                                                Value="{StaticResource SolidColorBrush_LightBrownishGray}"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="TextElement.Foreground"
                                                TargetName="content"
                                                Value="{StaticResource SolidColorBrush_LightSandy}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Border.Resources>
                            <DockPanel>
                                <Button x:Name="PART_HeaderButton" DockPanel.Dock="Top"
                                    FontWeight="{StaticResource FontWeightMedium}" Template="{StaticResource HeaderButton}"/>
                                <Button x:Name="PART_PreviousButton"
                                    DockPanel.Dock="Left" Template="{StaticResource LeftButton}"/>
                                <Button x:Name="PART_NextButton" DockPanel.Dock="Right" Template="{StaticResource RightButton}"/>
                                <Grid Margin="2,2,2,0">
                                    <Grid.Resources>
                                        <Style TargetType="Grid">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Top"/>
                                        </Style>
                                    </Grid.Resources>
                                    <Grid x:Name="PART_MonthView" Visibility="Visible">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                    </Grid>
                                    <Grid x:Name="PART_YearView" Visibility="Hidden">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                    </Grid>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Calendar}, Path=DisplayMode}" 
                                                                 Value="Year">
                            <Setter Property="Visibility" TargetName="PART_MonthView" Value="Hidden"/>
                            <Setter Property="Visibility" TargetName="PART_YearView" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Calendar}, Path=DisplayMode}" 
                                                                 Value="Decade">
                            <Setter Property="Visibility" TargetName="PART_MonthView" Value="Hidden"/>
                            <Setter Property="Visibility" TargetName="PART_YearView" Value="Visible"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Calendar" x:Key="CalendarMainStyle">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Calendar">
                    <StackPanel x:Name="PART_Root" HorizontalAlignment="Center">
                        <CalendarItem x:Name="PART_CalendarItem" 
                                  Background="{TemplateBinding Background}" 
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  Style="{StaticResource MyCalendarItem}"/>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="CalendarDayButtonStyle" Value="{StaticResource CalendarDayButtonMainStyle}"/>
        <Setter Property="CalendarButtonStyle" Value="{StaticResource CalendarButtonMainStyle}"/>
    </Style>
</ResourceDictionary>